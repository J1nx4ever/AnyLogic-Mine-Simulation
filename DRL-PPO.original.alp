					</Properties>
					<Action><![CDATA[for (Truck t : trucks) {

    if (t == null || t.currentSegment == null) {
        continue;
    }

    traceln(
        String.format(
            java.util.Locale.US,
            "[SPD],time=%.1f,truck=%d,phase=%s,loaded=%s,"
            + "segment=%s,speedKph=%.2f,baseKph=%.2f,"
            + "targetKph=%.2f,accel=%.3f,"
            + "hasFront=%s,frontId=%d,gap=%.2f,frontKph=%.2f",
            time(SECOND),
            t.truckId,
            t.executionPhase,
            t.isLoaded,
            t.currentSegment.key,
            t.egoSpeed * 3.6,
            t.segmentBaseSpeed * 3.6,
            t.dynamicTargetSpeed * 3.6,
            t.dynamicAccel,
            t.hasFront,
            t.front_id,
            t.frontDis,
            t.frontSpeed * 3.6
        )
    );
}]]></Action>
