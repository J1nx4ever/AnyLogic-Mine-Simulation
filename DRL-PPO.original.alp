responseObserver.onNext(response);
responseObserver.onCompleted();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783393827599</Id>
					<Name><![CDATA[updateFrontRearVehiclesRouteBased]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1520</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. 清空所有车辆前后车状态
for (Truck t : trucks) {
    t.hasFront = false;
    t.front_id = -1;
    t.frontSpeed = 0;
    t.frontDis = 9999;
    t.frontTtc = 9999;

    t.hasRear = false;
    t.rear_id = -1;
    t.rearSpeed = 0;
    t.rearDis = 9999;
}

// 2. 按 currentRouteKey 分组
java.util.HashMap<String, java.util.ArrayList<Truck>> routeGroups =
    new java.util.HashMap<String, java.util.ArrayList<Truck>>();

for (Truck t : trucks) {

    if (t.currentSegment == null) {
        continue;
    }

    if (t.currentRouteKey == null || t.currentRouteKey.length() == 0) {
        continue;
    }

    java.util.ArrayList<PathSegment> routeSegments = getRouteSegments(t.startPoint,t.destinationNode);

    if (routeSegments == null || routeSegments.size() == 0) {
        continue;
    }

    // 当前路段内进度
    t.segmentProgress =
        t.currentSegment.calcProgressFromRemainingDistance(t.disToInt);

    // 整条路径上的累计进度
    t.routeProgress =
        PathSegment.calcRouteProgress(
            routeSegments,
            t.currentSegment,
            t.disToInt
        );

    // 跨路段跟驰分组 key
    // 同一路径上的车才放在一起排序
    t.currentLaneKey = t.currentRouteKey;

    if (!routeGroups.containsKey(t.currentLaneKey)) {
        routeGroups.put(t.currentLaneKey, new java.util.ArrayList<Truck>());
    }

    routeGroups.get(t.currentLaneKey).add(t);
}

// 3. 每条路径内按 routeProgress 排序
for (String routeKey : routeGroups.keySet()) {

    java.util.ArrayList<Truck> list = routeGroups.get(routeKey);

    if (list.size() <= 1) {
        continue;
    }

    java.util.Collections.sort(list, new java.util.Comparator<Truck>() {
        @Override
        public int compare(Truck a, Truck b) {
            return Double.compare(a.routeProgress, b.routeProgress);
        }
    });

    // 4. 排序后相邻车辆就是前后车
    for (int i = 0; i < list.size(); i++) {

        Truck ego = list.get(i);

        Truck rear = null;
        Truck front = null;

        if (i > 0) {
            rear = list.get(i - 1);
        }

        if (i < list.size() - 1) {
            front = list.get(i + 1);
        }

        // 5. 前车
        if (front != null) {
            ego.hasFront = true;
            ego.front_id = front.truckId;
            ego.frontSpeed = front.egoSpeed;

            double d = DistanceRecorder(
                ego.getX(), ego.getY(),
                front.getX(), front.getY()
            );

            ego.frontDis = d;

            double relSpeed = ego.egoSpeed - front.egoSpeed;

            if (relSpeed > 0.1) {
                ego.frontTtc = d / relSpeed;
            } else {
                ego.frontTtc = 9999;
            }
        }

        // 6. 后车
        if (rear != null) {
            ego.hasRear = true;
            ego.rear_id = rear.truckId;
            ego.rearSpeed = rear.egoSpeed;

            double d = DistanceRecorder(
                ego.getX(), ego.getY(),
                rear.getX(), rear.getY()
            );

            ego.rearDis = d;
        }
    }

}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783412824422</Id>
					<Name><![CDATA[test]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1520</X><Y>-600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. 清空所有车辆前后车状态
traceln("========== 开始跟驰状态计算 ==========");
traceln("总车辆数: " + trucks.size());

for (Truck t : trucks) {
    t.hasFront = false;
    t.front_id = -1;
    t.frontSpeed = 0;
    t.frontDis = 9999;
    t.frontTtc = 9999;

    t.hasRear = false;
    t.rear_id = -1;
    t.rearSpeed = 0;
    t.rearDis = 9999;
}
traceln("1. 已清空所有车辆的前后车状态");

// 2. 按 currentRouteKey 分组
java.util.HashMap<String, java.util.ArrayList<Truck>> routeGroups =
    new java.util.HashMap<String, java.util.ArrayList<Truck>>();

int validTruckCount = 0;
int skippedCount = 0;

for (Truck t : trucks) {
    traceln("--- 处理车辆 ID: " + t.truckId + " ---");

    if (t.currentSegment == null) {
        traceln("  ⚠ 跳过: currentSegment 为空");
        skippedCount++;
        continue;
    }

    if (t.currentRouteKey == null || t.currentRouteKey.length() == 0) {
        traceln("  ⚠ 跳过: currentRouteKey 为空或长度为0");
        skippedCount++;
        continue;
    }

    java.util.ArrayList<PathSegment> routeSegments = getRouteSegments(t.startPoint, t.destinationNode);

    if (routeSegments == null || routeSegments.size() == 0) {
        traceln("  ⚠ 跳过: routeSegments 为空或大小为0");
        skippedCount++;
        continue;
    }

    // 当前路段内进度
    t.segmentProgress = t.currentSegment.calcProgressFromRemainingDistance(t.disToInt);
    traceln("  当前路段进度: " + String.format("%.4f", t.segmentProgress) + 
                       " (剩余距离: " + t.disToInt + ")");

    // 整条路径上的累计进度
    t.routeProgress = PathSegment.calcRouteProgress(routeSegments, t.currentSegment, t.disToInt);
    traceln("  整条路径进度: " + String.format("%.4f", t.routeProgress));

    // 跨路段跟驰分组 key
    t.currentLaneKey = t.currentRouteKey;
    traceln("  路径分组 Key: " + t.currentLaneKey);

    if (!routeGroups.containsKey(t.currentLaneKey)) {
        routeGroups.put(t.currentLaneKey, new java.util.ArrayList<Truck>());
        traceln("  创建新分组: " + t.currentLaneKey);
    }

    routeGroups.get(t.currentLaneKey).add(t);
    validTruckCount++;
    traceln("  ✓ 成功添加到分组，当前分组大小: " + routeGroups.get(t.currentLaneKey).size());
}

traceln("2. 分组完成: 有效车辆 " + validTruckCount + " 辆，跳过 " + skippedCount + " 辆");
traceln("  分组数量: " + routeGroups.size());
for (String key : routeGroups.keySet()) {
    traceln("    分组 [" + key + "] 包含 " + routeGroups.get(key).size() + " 辆车");
}

// 3. 每条路径内按 routeProgress 排序
int processedGroups = 0;
int totalPairs = 0;

for (String routeKey : routeGroups.keySet()) {
    traceln("");
    traceln("========== 处理分组: " + routeKey + " ==========");
    
    java.util.ArrayList<Truck> list = routeGroups.get(routeKey);
    traceln("  分组内车辆数: " + list.size());

    if (list.size() <= 1) {
        traceln("  分组内车辆 ≤ 1，跳过排序和配对");
        continue;
    }

    // 排序前打印
    traceln("  排序前车辆顺序 (routeProgress):");
    for (int idx = 0; idx < list.size(); idx++) {
        Truck t = list.get(idx);
        traceln("    [" + idx + "] ID:" + t.truckId + 
                           " progress:" + String.format("%.4f", t.routeProgress) +
                           " pos:(" + String.format("%.2f", t.getX()) + "," + 
                           String.format("%.2f", t.getY()) + ")");
    }

    java.util.Collections.sort(list, new java.util.Comparator<Truck>() {
        @Override
        public int compare(Truck a, Truck b) {
            return Double.compare(a.routeProgress, b.routeProgress);
        }
    });

    // 排序后打印
    traceln("  排序后车辆顺序 (routeProgress):");
    for (int idx = 0; idx < list.size(); idx++) {
        Truck t = list.get(idx);
        traceln("    [" + idx + "] ID:" + t.truckId + 
                           " progress:" + String.format("%.4f", t.routeProgress) +
                           " pos:(" + String.format("%.2f", t.getX()) + "," + 
                           String.format("%.2f", t.getY()) + ")");
    }

    // 4. 排序后相邻车辆就是前后车
    for (int i = 0; i < list.size(); i++) {
        Truck ego = list.get(i);
        traceln("");
        traceln("  配对车辆 [" + i + "] ID:" + ego.truckId);

        Truck rear = null;
        Truck front = null;

        if (i > 0) {
            rear = list.get(i - 1);
            traceln("    后车: ID:" + rear.truckId + 
                               " progress:" + String.format("%.4f", rear.routeProgress));
        }

        if (i < list.size() - 1) {
            front = list.get(i + 1);
            traceln("    前车: ID:" + front.truckId + 
                               " progress:" + String.format("%.4f", front.routeProgress));
        }

        // 5. 前车
        if (front != null) {
            ego.hasFront = true;
            ego.front_id = front.truckId;
            ego.frontSpeed = front.egoSpeed;

            double d = DistanceRecorder(ego.getX(), ego.getY(), front.getX(), front.getY());
            ego.frontDis = d;

            double relSpeed = ego.egoSpeed - front.egoSpeed;
            traceln("    前车信息:");
            traceln("      - 距离: " + String.format("%.2f", d));
            traceln("      - 前车速度: " + String.format("%.2f", front.egoSpeed));
            traceln("      - 自车速度: " + String.format("%.2f", ego.egoSpeed));
            traceln("      - 相对速度: " + String.format("%.2f", relSpeed));

            if (relSpeed > 0.1) {
                ego.frontTtc = d / relSpeed;
                traceln("      - TTC: " + String.format("%.2f", ego.frontTtc));
            } else {
                ego.frontTtc = 9999;
                traceln("      - TTC: 9999 (相对速度 ≤ 0.1)");
            }
            totalPairs++;
        } else {
            traceln("    无前车 (已是队列第一辆)");
        }

        // 6. 后车
        if (rear != null) {
            ego.hasRear = true;
            ego.rear_id = rear.truckId;
            ego.rearSpeed = rear.egoSpeed;

            double d = DistanceRecorder(ego.getX(), ego.getY(), rear.getX(), rear.getY());
            ego.rearDis = d;
            
            traceln("    后车信息:");
            traceln("      - 距离: " + String.format("%.2f", d));
            traceln("      - 后车速度: " + String.format("%.2f", rear.egoSpeed));
        } else {
            traceln("    无后车 (已是队列最后一辆)");
        }
        
        // 打印该车最终状态
        traceln("    该车最终状态:");
        traceln("      hasFront: " + ego.hasFront + 
                           ", front_id: " + ego.front_id +
                           ", frontDis: " + String.format("%.2f", ego.frontDis) +
                           ", frontTtc: " + String.format("%.2f", ego.frontTtc));
        traceln("      hasRear: " + ego.hasRear + 
                           ", rear_id: " + ego.rear_id +
                           ", rearDis: " + String.format("%.2f", ego.rearDis));
    }
    
    processedGroups++;
}

traceln("");
traceln("========== 计算完成 ==========");
traceln("处理分组数: " + processedGroups);
traceln("总配对关系: " + totalPairs + " 对前后车");
traceln("有效车辆数: " + validTruckCount);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783413789953</Id>
					<Name><![CDATA[updateDownstreamMergeFrontVehicles]]></Name>
					<X>1780</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783414289948</Id>
					<Name><![CDATA[getCurrentSegmentIndex]]></Name>
					<X>1780</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || t.currentSegment == null || t.currentRouteSegments == null) {
    return -1;
}

for (int i = 0; i < t.currentRouteSegments.size(); i++) {
    PathSegment seg = t.currentRouteSegments.get(i);

    if (seg == null) {
        continue;
    }

    if (seg.isSameDirectedSegment(t.currentSegment)) {
        return i;
    }
}

return -1;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476220222</Id>
					<Name><![CDATA[clearConflictState]]></Name>
					<X>1770</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) {
    return;
}

if (t.conflict_id == null) {
    t.conflict_id = new java.util.ArrayList<Integer>();
} else {
    t.conflict_id.clear();
}

if (t.conflictSpeed == null) {
    t.conflictSpeed = new java.util.ArrayList<Float>();
} else {
    t.conflictSpeed.clear();
}

if (t.conflictEta == null) {
    t.conflictEta = new java.util.ArrayList<Float>();
} else {
    t.conflictEta.clear();
}

if (t.conflictDist == null) {
    t.conflictDist = new java.util.ArrayList<Float>();
} else {
    t.conflictDist.clear();
}

t.conflictNodeKey = "";
t.egoConflictEta = 9999;
t.egoConflictDist = 9999;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783476381474</Id>
					<Name><![CDATA[getTruckConflictNodeKey]]></Name>
					<X>1770</X><Y>-550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) {
    return "";
}

// 优先用 currentSegment 的有向终点
try {
    if (t.currentSegment != null && t.currentSegment.getDirectedTo() != null) {
        return t.currentSegment.getDirectedTo();
    }
} catch (Exception e) {}

// 如果没有 getDirectedTo()，直接用 to
try {
    if (t.currentSegment != null && t.currentSegment.to != null) {
        return t.currentSegment.to;
    }
} catch (Exception e) {}

return "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476526373</Id>
					<Name><![CDATA[calcDistanceToNode]]></Name>
					<X>1770</X><Y>-520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nodeKey]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || nodeKey == null || nodeKey.length() == 0) {
    return 9999;
}

try {
    com.anylogic.engine.markup.PointNode node = getRoadPointNode(nodeKey);

    if (node == null) {
        traceln("[Conflict] node not found: " + nodeKey);
        return 9999;
    }

    double tx = t.getX();
    double ty = t.getY();

    double nx;
    double ny;

    try {
        nx = node.getX();
        ny = node.getY();
    } catch (Exception ex) {
        traceln(
            "[Conflict] invalid PointNode coordinates. "
            + "truck=" + t.truckId
            + ", node=" + nodeKey
            + ", nodeObj=" + node
            + ", err=" + ex.getMessage()
        );
        return 9999;
    }

    return DistanceRecorder(tx, ty, nx, ny);

} catch (Exception e) {
    traceln(
        "[Conflict] calcDistanceToNode failed. truck="
        + t.truckId
        + ", node=" + nodeKey
        + ", err=" + e.getMessage()
    );

    return 9999;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476683760</Id>
					<Name><![CDATA[calcEta]]></Name>
					<X>1770</X><Y>-490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dist]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speed]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (dist >= 9999) {
    return 9999;
}

if (speed <= 0.1) {
    return 9999;
}

return dist / speed;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783832120324</Id>
					<Name><![CDATA[selectNextLoadSiteAI2]]></Name>
					<X>660</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[// 1. 调用 Main 里的函数，打包当前这辆车的 28 维状态
Observation currentObs = buildObservation(t);

// 2. 将状态塞入通信请求包 (DispatchRequest)
DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(t.truckId)
    .setObs(currentObs)
    .build();

// ========================================================
// 3. 传递向量，并阻塞等待 Python 大脑返回消息！
//    注意：执行到这里时，AnyLogic 的仿真时间会瞬间静止，
//    直到 Python 算出了结果，时间才会继续流逝。
// ========================================================
int id =  rlClient.getNextDestination(request);
traceln("前往LoadSite:" + id );
return id;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783842936574</Id>
					<Name><![CDATA[buildFrontendStateJson]]></Name>
					<X>1910</X><Y>-240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String simId = "SIM_001";
double currentSimTime = time(SECOND);
String currentStatus = "RUNNING";

// ==============================
// Trucks：保持旧接口，并追加 FROZEN-1.0 可选字段
// ==============================
StringBuilder trucksBuilder = new StringBuilder("[");

for (int i = 0; i < trucks.size(); i++) {
    Truck truck = trucks.get(i);

    if (i > 0) {
        trucksBuilder.append(",");
    }

    String target = truck.targetNodeName == null
        ? ""
        : truck.targetNodeName;
    String phase = truck.executionPhase == null
        || truck.executionPhase.isBlank()
        ? "UNKNOWN"
        : truck.executionPhase;

    // VehicleState.state 与权威 executionPhase 保持一致。
    // 不再使用 debugLastAction；该调试字段会在每个道路分段开始时提前写入
    // ArriveLoad，从而把仍在行驶的车辆错误映射成 WAITING_LOAD。
    String state;
    switch (phase) {
        case "IDLE":
            state = "IDLE";
            break;
        case "TO_LOAD":
            state = "TO_LOAD";
            break;
        case "WAITING_LOAD":
            state = "WAITING_LOAD";
            break;
        case "LOADING":
            state = "LOADING";
            break;
        case "TO_DUMP":
            state = "TO_DUMP";
            break;
        case "WAITING_DUMP":
            state = "WAITING_UNLOAD";
            break;
        case "DUMPING":
            state = "UNLOADING";
            break;
        case "COMPLETED":
            state = "IDLE";
            break;
        default:
            state = "UNKNOWN";
            break;
    }

    String dispatchTargetJson = truck.targetSiteBusinessId == null
        || truck.targetSiteBusinessId.isBlank()
        ? "null"
        : "\"" + escapeFrontendJson(truck.targetSiteBusinessId) + "\"";
    String activeDecisionJson = truck.activeDecisionId == null
        || truck.activeDecisionId.isBlank()
        ? "null"
        : "\"" + escapeFrontendJson(truck.activeDecisionId) + "\"";
    String legFromJson = truck.currentLegFromSiteId == null
        || truck.currentLegFromSiteId.isBlank()
        ? "null"
        : "\"" + escapeFrontendJson(truck.currentLegFromSiteId) + "\"";
    String legToJson = truck.currentLegToSiteId == null
        || truck.currentLegToSiteId.isBlank()
        ? "null"
        : "\"" + escapeFrontendJson(truck.currentLegToSiteId) + "\"";
    String nextSiteJson = truck.nextSiteId == null
        || truck.nextSiteId.isBlank()
        ? "null"
        : "\"" + escapeFrontendJson(truck.nextSiteId) + "\"";
    String accelerationJson = Double.isFinite(truck.cmdAccel)
        ? String.format(java.util.Locale.US, "%.6f", truck.cmdAccel)
        : "null";

    trucksBuilder.append(
        String.format(
            java.util.Locale.US,
            "{"
            + "\"truckId\":%d,"
            + "\"x\":%.6f,"
            + "\"y\":%.6f,"
            + "\"state\":\"%s\","
            + "\"target\":\"%s\","
            + "\"speed\":%.6f,"
            + "\"payload\":%.6f,"
            + "\"dispatchTargetId\":%s,"
            + "\"accelerationMps2\":%s,"
            + "\"activeDispatchDecisionId\":%s,"
            + "\"executionPhase\":\"%s\","
            + "\"currentLegFromSiteId\":%s,"
            + "\"currentLegToSiteId\":%s,"
            + "\"nextSiteId\":%s"
            + "}",
            truck.truckId,
            truck.getX(),
            truck.getY(),
            escapeFrontendJson(state),
            escapeFrontendJson(target),
            truck.getSpeed(MPS),
            truck.payloadTons,
            dispatchTargetJson,
            accelerationJson,
            activeDecisionJson,
            escapeFrontendJson(phase),
            legFromJson,
            legToJson,
            nextSiteJson
        )
    );
}

trucksBuilder.append("]");
String trucksJson = trucksBuilder.toString();

// ==============================
// LoadSite / Shovel：保持旧格式
// ==============================
StringBuilder shovelsBuilder = new StringBuilder("[");

for (int i = 0; i < loadSites.size(); i++) {
    LoadSite loadSite = loadSites.get(i);

    if (i > 0) {
        shovelsBuilder.append(",");
    }

    shovelsBuilder.append(
        String.format(
            java.util.Locale.US,
            "{"
            + "\"shovelId\":\"%s\","
            + "\"queueLength\":%d,"
            + "\"available\":%s,"
            + "\"grade\":%.6f,"
            + "\"remainingTonnage\":%.6f"
            + "}",
            escapeFrontendJson(loadSite.siteName),
            loadSite.queue.size(),
            Boolean.toString(loadSite.available && !loadSite.busy),
            loadSite.grade,
            loadSite.remainingTons
        )
    );
}

shovelsBuilder.append("]");
String shovelsJson = shovelsBuilder.toString();

// ==============================
// KPI：保持旧格式
// ==============================
double oreTonnage = crusherOreTons;
double wasteTonnage = totalWasteMoved;
double totalTonnage = oreTonnage + wasteTonnage;
double gradeDeviation = abs(gradeGap);
double totalWaitingTime = totalWaitTime;

String kpiJson = String.format(
    java.util.Locale.US,
    "{"
    + "\"oreTonnage\":%.6f,"
    + "\"wasteTonnage\":%.6f,"
    + "\"totalTonnage\":%.6f,"
    + "\"gradeDeviation\":%.6f,"
    + "\"totalWaitingTime\":%.6f"
    + "}",
    oreTonnage,
    wasteTonnage,
    totalTonnage,
    gradeDeviation,
    totalWaitingTime
);

// ==============================
// lastDispatch：没有真实推理结果时发送 null
// ==============================
String lastDispatchJson = "null";

if (hasDispatchResult
        && lastDecisionId != null
        && !lastDecisionId.isBlank()) {
    String logitsJson = lastDecisionLogits == null
        ? "[]"
        : lastDecisionLogits.toString();

    lastDispatchJson = String.format(
        java.util.Locale.US,
        "{"
        + "\"requestId\":\"%s\","
        + "\"truckId\":%d,"
        + "\"modelVersion\":\"%s\","
        + "\"rawAction\":%d,"
        + "\"executedAction\":%d,"
        + "\"value\":%.9f,"
        + "\"logits\":%s,"
        + "\"maskApplied\":false,"
        + "\"fallbackUsed\":%s,"
        + "\"latencyUs\":%d,"
        + "\"provider\":\"TensorrtExecutionProvider\","
        + "\"errorCode\":\"%s\""
        + "}",
        escapeFrontendJson(lastDecisionId),
        lastDispatchTruckId,
        escapeFrontendJson(lastDecisionModel),
        lastDecisionRawAction,
        lastDecisionExecutedAction,
        lastDecisionValue,
        logitsJson,
        Boolean.toString(lastDecisionFallback),
        lastDecisionLatencyUs,
        escapeFrontendJson(lastDispatchErrorCode)
    );
}

return String.format(
    java.util.Locale.US,
    "{"
    + "\"simId\":\"%s\","
    + "\"simTime\":%.6f,"
    + "\"status\":\"%s\","
    + "\"trucks\":%s,"
    + "\"shovels\":%s,"
    + "\"kpi\":%s,"
    + "\"lastDispatch\":%s"
    + "}",
    escapeFrontendJson(simId),
    currentSimTime,
    escapeFrontendJson(currentStatus),
    trucksJson,
    shovelsJson,
    kpiJson,
    lastDispatchJson
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783842972829</Id>
					<Name><![CDATA[reportStateToBackend]]></Name>
					<X>1910</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String requestJson = buildFrontendStateJson();

    java.net.http.HttpRequest request =
        java.net.http.HttpRequest.newBuilder()
            .uri(
                java.net.URI.create(
                    "http://localhost:8080/api/simulation/state"
                )
            )
            .timeout(java.time.Duration.ofSeconds(5))
            .header("Content-Type", "application/json")
            .header("Accept", "application/json")
            .POST(
                java.net.http.HttpRequest.BodyPublishers.ofString(
                    requestJson,
                    java.nio.charset.StandardCharsets.UTF_8
                )
            )
            .build();

    /*
     * 使用异步请求，避免 HTTP 请求阻塞 AnyLogic 仿真线程。
     *
     * 网络异常或后端未启动时，只打印错误，不抛出到仿真主流程。
     */
    frontendStateHttpClient
        .sendAsync(
            request,
            java.net.http.HttpResponse.BodyHandlers.ofString(
                java.nio.charset.StandardCharsets.UTF_8
            )
        )
        .whenComplete((response, throwable) -> {
            try {
                if (throwable != null) {
                    traceln(
                        "[StateReport] HTTP request failed: "
                        + throwable.getMessage()
                    );
                    return;
                }

                int statusCode = response.statusCode();

                if (statusCode < 200 || statusCode >= 300) {
                    traceln(
                        "[StateReport] Backend returned HTTP "
                        + statusCode
                        + ", response body: "
                        + response.body()
                    );
                }

                /*
                 * 调试阶段可打开下面的日志。
                 * 正式运行时建议关闭，避免每秒输出一条日志。
                 */
                // else {
                //     traceln(
                //         "[StateReport] State reported successfully, HTTP "
                //         + statusCode
                //     );
                // }

            } catch (Exception callbackException) {
                /*
                 * 回调函数中的异常同样不允许中断仿真。
                 */
                traceln(
                    "[StateReport] Response callback error: "
                    + callbackException.getMessage()
                );
            }
        });

} catch (Exception exception) {
    /*
     * JSON 构建、URI 创建或 HTTP 请求创建失败时，
     * 仅记录错误，不中断 AnyLogic 仿真。
     */
    traceln(
        "[StateReport] Failed to report simulation state: "
        + exception.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1785480216924</Id>
					<Name><![CDATA[escapeFrontendJson]]></Name>
					<X>2140</X><Y>-270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (value == null) {
    return "";
}

return value
    .replace("\\", "\\\\")
    .replace("\"", "\\\"")
    .replace("\b", "\\b")
    .replace("\f", "\\f")
    .replace("\n", "\\n")
    .replace("\r", "\\r")
    .replace("\t", "\\t");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1785650274480</Id>
					<Name><![CDATA[buildLayoutJson]]></Name>
					<X>2620</X><Y>-250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[

StringBuilder sb=new StringBuilder();


sb.append("{");
sb.append("\"layoutId\":\"openpit-layout-01\",");
sb.append("\"width\":1920,");
sb.append("\"height\":957,");


sb.append("\"devices\":[");


for(int i=0;i<layoutEntities.size();i++){

    LayoutEntity e=layoutEntities.get(i);


    sb.append("{");

    sb.append("\"id\":\"")
      .append(e.id)
      .append("\",");


    sb.append("\"type\":\"")
      .append(e.type)
      .append("\",");


    sb.append("\"x\":")
      .append(e.x)
      .append(",");


    sb.append("\"y\":")
      .append(e.y);


    sb.append("}");


    if(i<layoutEntities.size()-1)
        sb.append(",");

}


sb.append("]}");


return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785987459229</Id>
					<Name><![CDATA[refreshSpeedObservations]]></Name>
					<X>970</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
 * 首先更新每辆车自身状态：
 * egoSpeed、disToInt、tta等。
 */
for (Truck t : trucks) {
    if (t == null) {
        continue;
    }

    try {
        t.updateBasicSpeedState();
    } catch (Throwable e) {
        traceln(
            "[SpeedControl] updateBasicSpeedState failed"
            + ", truck=" + t.truckId
            + ", error=" + e.getMessage()
        );
    }
}

/*
 * 自身状态更新完成后，再计算车辆之间的关系。
 */
updateFrontRearVehicles();
updateConflictVehicles();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788854998991</Id>
					<Name><![CDATA[estimateRouteTravelTimeSeconds]]></Name>
					<X>2240</X><Y>-800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[fromNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[loaded]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[ArrayList<PathSegment> segments =
    getRouteSegments(fromNode, toNode);

if (segments == null || segments.isEmpty()) {
    traceln(
        "[TravelTime] Route not found: "
        + fromNode + " -> " + toNode
    );
    return Double.POSITIVE_INFINITY;
}

double totalSeconds = 0;

for (PathSegment segment : segments) {
    if (segment == null || segment.speedLimit <= 0) {
        return Double.POSITIVE_INFINITY;
    }

    double speed = segment.speedLimit;

    // P0阶段暂时使用路段限速。
    // 后续Physics ETA再区分空载、重载和坡度。
    totalSeconds += segment.length / speed;
}

return totalSeconds;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789528975366</Id>
					<Name><![CDATA[setPhysicalBaseSpeed]]></Name>
					<X>2910</X><Y>-630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[emptyKph]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[loadedKph]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double emptyMps = emptyKph / 3.6;
double loadedMps = loadedKph / 3.6;

emptyBaseSpeedMps.put(a + "_" + b, emptyMps);
emptyBaseSpeedMps.put(b + "_" + a, emptyMps);

loadedBaseSpeedMps.put(a + "_" + b, loadedMps);
loadedBaseSpeedMps.put(b + "_" + a, loadedMps);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789529253603</Id>
					<Name><![CDATA[initDynamicSpeedModel]]></Name>
					<X>2910</X><Y>-600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[emptyBaseSpeedMps.clear();
loadedBaseSpeedMps.clear();

// 第一版建议仅做小幅、确定性的 segment 差异。
// 后续可根据坡度或历史运行数据调整。

setPhysicalBaseSpeed("Crusher", "intersection1",       25.0, 15.0);
setPhysicalBaseSpeed("intersection1", "intersection2", 24.0, 14.5);
setPhysicalBaseSpeed("intersection2", "intersection3", 26.0, 15.5);
setPhysicalBaseSpeed("intersection3", "ShovelOreHigh2",24.0, 14.0);
setPhysicalBaseSpeed("intersection2", "ShovelOreHigh1",23.0, 13.5);
setPhysicalBaseSpeed("intersection3", "ShovelOreLow",  22.0, 13.0);
setPhysicalBaseSpeed("intersection2", "ShovelWaste",   24.0, 14.0);
setPhysicalBaseSpeed("dumpNode", "intersection2",      25.0, 15.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789529408509</Id>
					<Name><![CDATA[getBaseSpeedMps]]></Name>
					<X>2910</X><Y>-570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[segment]]></Name>
						<Type><![CDATA[PathSegment]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[loaded]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (segment == null) {
    return 0;
}

HashMap<String, Double> table =
    loaded ? loadedBaseSpeedMps : emptyBaseSpeedMps;

Double value = table.get(segment.key);

if (value != null && value > 0) {
    return value;
}

// 缺少配置时使用确定性默认值
return loaded ? 15.0 / 3.6 : 25.0 / 3.6;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789540270484</Id>
					<Name><![CDATA[applyDynamicSpeed]]></Name>
					<X>2910</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[useEndogenousCongestion]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (!useLocalDynamicSpeed
    || t == null
    || t.currentSegment == null) {
    return;
}

if (!"TO_LOAD".equals(t.executionPhase)
    && !"TO_DUMP".equals(t.executionPhase)) {
    return;
}


// =====================================================
// 0. 公共参数检查
// 两个实验环境共同使用相同的速度响应参数
// =====================================================

double dt = speedDtSec;

if (!Double.isFinite(dt) || dt <= 0.0) {
    return;
}

if (!Double.isFinite(speedTauSec)
    || speedTauSec <= 1e-6) {
    return;
}

if (!Double.isFinite(maxAccelMps2)
    || maxAccelMps2 < 0.0) {
    return;
}

if (!Double.isFinite(maxDecelMps2)
    || maxDecelMps2 < 0.0) {
    return;
}

if (!Double.isFinite(maxJerkMps3)
    || maxJerkMps3 < 0.0) {
    return;
}

/*
 * 跟驰参数只在启用内生拥堵时使用。
 * 因此外生环境不会因为跟驰参数配置问题而停止速度更新。
 */
if (useEndogenousCongestion) {

    if (!Double.isFinite(criticalGapM)
        || criticalGapM < 0.0) {
        return;
    }

    if (!Double.isFinite(safeGapM)
        || safeGapM <= criticalGapM) {
        return;
    }

    if (!Double.isFinite(followRangeM)
        || followRangeM <= safeGapM) {
        return;
    }

    if (!Double.isFinite(followTauSec)
        || followTauSec <= 1e-6) {
        return;
    }

    if (!Double.isFinite(brakeTauSec)
        || brakeTauSec <= 1e-6) {
        return;
    }

    if (!Double.isFinite(followSpeedMarginMps)
        || followSpeedMarginMps < 0.0) {
        return;
    }
}


// =====================================================
// 1. 当前速度
// =====================================================

double currentSpeed;

try {
    currentSpeed = t.getSpeed();
} catch (Exception e) {
    currentSpeed = t.egoSpeed;
}

if (!Double.isFinite(currentSpeed)
    || currentSpeed < 0.0) {
    currentSpeed = 0.0;
}


// =====================================================
// 2. 统一的自由速度模型
//
// baseSpeed：区分空载、重载以及不同路段
// freeSpeedFactor：车辆初始化时生成的小扰动
//
// 该自由速度在两个实验环境中完全相同。
// =====================================================

double baseSpeed =
    getBaseSpeedMps(t.currentSegment, t.isLoaded);

if (!Double.isFinite(baseSpeed)
    || baseSpeed <= 0.0) {
    return;
}

double freeSpeedFactor =
    t.isLoaded
    ? t.loadedFreeSpeedFactor
    : t.emptyFreeSpeedFactor;

if (!Double.isFinite(freeSpeedFactor)
    || freeSpeedFactor <= 0.0) {
    freeSpeedFactor = 1.0;
}

double freeSpeed =
    baseSpeed * freeSpeedFactor;

if (!Double.isFinite(freeSpeed)
    || freeSpeed <= 0.0) {
    freeSpeed = baseSpeed;
}


// =====================================================
// 3. 默认状态：外生运输环境
//
// 只使用“空载/重载基础速度 × 小扰动”，
// 完全忽略车辆之间的距离和速度。
// =====================================================

double desiredSpeed = freeSpeed;
double responseTau = speedTauSec;

t.speedRegime = "FREE";


// =====================================================
// 4. 车辆交互开关
//
// false：外生环境，只使用自由速度
// true ：内生环境，在同一个自由速度上叠加跟驰/制动
// =====================================================

double gap = t.frontDis;
double frontSpeed = 0.0;

boolean validFront =
    useEndogenousCongestion
    && t.hasFront
    && Double.isFinite(gap)
    && gap >= 0.0;

if (validFront) {

    frontSpeed = t.frontSpeed;

    if (!Double.isFinite(frontSpeed)
        || frontSpeed < 0.0) {
        frontSpeed = 0.0;
    }

    t.minGapThisLeg =
        Math.min(t.minGapThisLeg, gap);


    // -------------------------------------------------
    // 4.1 自由流：前车在交互范围之外
    // -------------------------------------------------

    if (gap >= followRangeM) {

        t.speedRegime = "FREE";
        responseTau = speedTauSec;
        desiredSpeed = freeSpeed;
    }


    // -------------------------------------------------
    // 4.2 跟驰流：safeGapM <= gap < followRangeM
    // -------------------------------------------------

    else if (gap >= safeGapM) {

        t.speedRegime = "FOLLOW";
        responseTau = followTauSec;

        double z =
            (gap - safeGapM)
            / (followRangeM - safeGapM);

        z = Math.max(
            0.0,
            Math.min(1.0, z)
        );

        // 三次平滑插值，避免在状态边界速度突变
        double smooth =
            z * z * (3.0 - 2.0 * z);

        double closeFollowSpeed =
            Math.min(
                freeSpeed,
                Math.max(
                    0.0,
                    frontSpeed - followSpeedMarginMps
                )
            );

        desiredSpeed =
            closeFollowSpeed
            + (freeSpeed - closeFollowSpeed) * smooth;

        /*
         * 跟驰状态下目标速度不得高于前车速度，
         * 防止后车在交互区间内持续缩短车距。
         */
        desiredSpeed =
            Math.min(desiredSpeed, frontSpeed);
    }


    // -------------------------------------------------
    // 4.3 制动流：gap < safeGapM
    // -------------------------------------------------

    else {

        t.speedRegime = "BRAKE";
        responseTau = brakeTauSec;

        double followSpeed =
            Math.min(
                freeSpeed,
                Math.max(
                    0.0,
                    frontSpeed - followSpeedMarginMps
                )
            );

        /*
         * gap = safeGapM 时 q = 1；
         * gap <= criticalGapM 时 q = 0。
         */
        double q =
            (gap - criticalGapM)
            / (safeGapM - criticalGapM);

        q = Math.max(
            0.0,
            Math.min(1.0, q)
        );

        double brakeFactor =
            q * q * (3.0 - 2.0 * q);

        desiredSpeed =
            followSpeed * brakeFactor;
    }
}


// =====================================================
// 5. 目标速度限制
// =====================================================

desiredSpeed =
    Math.max(
        0.0,
        Math.min(freeSpeed, desiredSpeed)
    );

if (!Double.isFinite(desiredSpeed)) {
    desiredSpeed = freeSpeed;
}


// =====================================================
// 6. 两个环境共用相同的一阶速度响应
// =====================================================

double rawAccel =
    (desiredSpeed - currentSpeed)
    / responseTau;

if (!Double.isFinite(rawAccel)) {
    rawAccel = 0.0;
}


// =====================================================
// 7. 内生拥堵环境的安全减速
// =====================================================

if (validFront && gap < safeGapM) {

    double severity =
        (safeGapM - gap)
        / (safeGapM - criticalGapM);

    severity =
        Math.max(
            0.0,
            Math.min(1.0, severity)
        );

    double safetyDecel =
        -0.3
        - (maxDecelMps2 - 0.3) * severity;

    rawAccel =
        Math.min(rawAccel, safetyDecel);
}


// =====================================================
// 8. 加速度限制
// =====================================================

rawAccel =
    Math.max(
        -maxDecelMps2,
        Math.min(
            maxAccelMps2,
            rawAccel
        )
    );


// =====================================================
// 9. Jerk 限制
// 两个环境使用相同的速度平滑机制
// =====================================================

if (!Double.isFinite(t.dynamicAccel)) {
    t.dynamicAccel = 0.0;
}

double maxAccelChange =
    maxJerkMps3 * dt;

if (!Double.isFinite(maxAccelChange)
    || maxAccelChange < 0.0) {
    maxAccelChange = 0.0;
}

double lowerAccel =
    t.dynamicAccel - maxAccelChange;

double upperAccel =
    t.dynamicAccel + maxAccelChange;

double appliedAccel =
    Math.max(
        lowerAccel,
        Math.min(
            upperAccel,
            rawAccel
        )
    );

if (!Double.isFinite(appliedAccel)) {
    appliedAccel = 0.0;
}


// =====================================================
// 10. 更新速度
// =====================================================

double newSpeed =
    currentSpeed
    + appliedAccel * dt;


// =====================================================
// 11. 内生拥堵环境的最终安全约束
// =====================================================

if (validFront && gap < safeGapM) {

    double remainingGap =
        Math.max(
            0.0,
            gap - criticalGapM
        );

    double safetySpeedCeiling =
        frontSpeed + remainingGap / dt;

    newSpeed =
        Math.min(
            newSpeed,
            Math.max(0.01, safetySpeedCeiling)
        );
}

if (!Double.isFinite(newSpeed)) {
    return;
}


// =====================================================
// 12. 最终速度范围
//
// 当前速度若暂时高于自由速度，允许平滑下降，
// 避免强制截断导致速度跳变。
// =====================================================

double minMovingSpeedMps =
    validFront && gap < safeGapM
    ? 0.01
    : 0.1;

double upperSpeedMps =
    Math.max(currentSpeed, freeSpeed);

newSpeed =
    Math.max(
        minMovingSpeedMps,
        Math.min(newSpeed, upperSpeedMps)
    );

if (!Double.isFinite(newSpeed)) {
    return;
}


// =====================================================
// 13. 更新 Truck 动态状态
// =====================================================

t.dynamicAccel = appliedAccel;
t.dynamicTargetSpeed = desiredSpeed;
t.segmentBaseSpeed = baseSpeed;
t.freeSpeed = freeSpeed;
t.egoSpeed = newSpeed;


// =====================================================
// 14. 唯一速度应用出口
// =====================================================

try {

    t.setSpeed(newSpeed, MPS);

} catch (Exception e) {

    traceln(
        "[Speed] setSpeed failed"
        + ", truck=" + t.truckId
        + ", time=" + time()
        + ", endogenous=" + useEndogenousCongestion
        + ", segment=" + t.currentSegment
        + ", phase=" + t.executionPhase
        + ", loaded=" + t.isLoaded
        + ", newSpeed=" + newSpeed
        + ", currentSpeed=" + currentSpeed
        + ", desiredSpeed=" + desiredSpeed
        + ", baseSpeed=" + baseSpeed
        + ", freeSpeedFactor=" + freeSpeedFactor
        + ", freeSpeed=" + freeSpeed
        + ", gap=" + gap
        + ", frontSpeed=" + frontSpeed
        + ", appliedAccel=" + appliedAccel
        + ", err=" + e.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789540423751</Id>
					<Name><![CDATA[updateNextSegmentFrontVehicles]]></Name>
					<X>1780</X><Y>-850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Truck ego : trucks) {

    if (ego == null
        || ego.currentSegment == null
        || ego.hasFront
        || ego.disToInt > followRangeM) {
        continue;
    }

    int index = getCurrentSegmentIndex(ego);

    if (index < 0
        || ego.currentRouteSegments == null
        || index + 1 >= ego.currentRouteSegments.size()) {
        continue;
    }

    PathSegment nextSegment =
        ego.currentRouteSegments.get(index + 1);

    Truck nearest = null;
    double nearestProgress = Double.POSITIVE_INFINITY;

    for (Truck other : trucks) {

        if (other == ego || other.currentSegment == null) {
            continue;
        }

        if (!nextSegment.isSameDirectedSegment(other.currentSegment)) {
            continue;
        }

        double progress =
            nextSegment.calcProgressFromRemainingDistance(
                other.disToInt
            );

        if (progress < nearestProgress) {
            nearestProgress = progress;
            nearest = other;
        }
    }

    if (nearest != null) {
		double dx =
		    nearest.getX() - ego.getX();
		
		double dy =
		    nearest.getY() - ego.getY();
		
		double gap =
		    Math.sqrt(dx * dx + dy * dy);
		
		if (!Double.isFinite(gap)) {
		    continue;
		}

        if (gap <= followRangeM) {
            ego.hasFront = true;
            ego.front_id = nearest.truckId;
            ego.frontSpeed = nearest.egoSpeed;
            ego.frontDis = gap;

            double closingSpeed =
                ego.egoSpeed - nearest.egoSpeed;

            ego.frontTtc =
                closingSpeed > 0.1
                ? gap / closingSpeed
                : 9999;
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789643896796</Id>
					<Name><![CDATA[sampleTruncatedNormalFactor]]></Name>
					<X>2910</X><Y>-510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mean]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[std]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lower]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[upper]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(mean)
    || !Double.isFinite(std)
    || !Double.isFinite(lower)
    || !Double.isFinite(upper)
    || std <= 0
    || lower >= upper) {

    return 1.0;
}

// 拒绝采样：只接受位于截断区间内的正态样本
for (int i = 0; i < 100; i++) {

    double value = normal(mean, std);

    if (Double.isFinite(value)
        && value >= lower
        && value <= upper) {

        return value;
    }
}

// 极低概率下的保护返回
return Math.max(
    lower,
    Math.min(upper, mean)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406812940</Id>
					<Name><![CDATA[clip]]></Name>
					<X>-440</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lower]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[upper]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.max(lower, Math.min(upper, value));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406852354</Id>
					<Name><![CDATA[gradeReward]]></Name>
					<X>-440</X><Y>-810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double d;

if (gap < 0.0) {
    d = -gap / 0.02;
} else {
    d = gap / 0.01;
}

if (d <= 1.0) {
    // 合法区间内仅保留很小的中心偏好
    // 目标点0.60，合法边界0.50
    return 0.5 + 0.1 * (1.0 - d);
}

// 超出合法区间立即转为负值
return -clip(
    (d - 1.0) / 0.5,
    0.0,
    1.0
);
/*stage1
double d;

if (gap < 0.0) {
    d = -gap / 0.02;
} else {
    d = gap / 0.01;
}

// 安全区：目标点1.0，归一化偏差0.8处为0.5
if (d <= 0.8) {
    return 1.0 - 0.625 * d;
}

// 接近合法边界：奖励从0.5连续降低到0
if (d <= 1.0) {
    return 0.5 * (
        1.0 - (d - 0.8) / 0.2
    );
}

// 超出合法区间立即为负，d=1.5时达到-1
return -clip(
    (d - 1.0) / 0.5,
    0.0,
    1.0
);*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406881298</Id>
					<Name><![CDATA[getCumulativeWaitVehicleSeconds]]></Name>
					<X>-440</X><Y>-780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double waitMinutes =
    totalSystemLoadWaitTime + totalSystemDumpWaitTime;

// 尚未开始服务的车辆也必须持续贡献等待积分
for (Truck t : trucks) {
    if (t.isWaitingForLoadResource) {
        waitMinutes += Math.max(0.0, time(MINUTE) - t.queueEnterTime);
    }

    if (t.isWaitingForDumpResource) {
        waitMinutes += Math.max(
            0.0,
            time(MINUTE) - t.dumpQueueEnterTime
        );
    }
}

return waitMinutes * 60.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406915714</Id>
					<Name><![CDATA[settleCurrent2hWindow]]></Name>
					<X>-440</X><Y>-750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentWindowIndex < 0 || currentWindowIndex >= 4) {
    throw new IllegalStateException(
        "Invalid 2h window index: " + currentWindowIndex
    );
}

double grade =
    windowOreTons > 0
    ? windowMetalTons / windowOreTons
    : 0.0;

double gap =
    windowOreTons > 0
    ? targetGrade - grade
    : targetGrade; // 无矿不能按 gap=0 获得满分

closedWindowGrades[currentWindowIndex] = grade;
closedWindowGradeGaps[currentWindowIndex] = gap;

pendingGrade2hReward += wGrade2h * gradeReward(gap);

currentWindowIndex++;
windowOreTons = 0.0;
windowMetalTons = 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790406935927</Id>
					<Name><![CDATA[advanceCompletedGradeWindows]]></Name>
					<X>-440</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nowSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// 只关闭前三个边界；第 4 个窗口由 terminal 统一封账
while (
    currentWindowIndex < 3
    && nowSec >= (currentWindowIndex + 1) * rlWindowSeconds
) {
    settleCurrent2hWindow();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790407312841</Id>
					<Name><![CDATA[finishEpisodeAndNotify]]></Name>
					<X>-440</X><Y>-670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (episodeClosed) {
    return;
}

double nowSec = rlShiftSeconds;

// 先关闭尚未关闭的前三个窗口
advanceCompletedGradeWindows(nowSec);

// 再关闭第 4 个窗口
if (currentWindowIndex == 3) {
    settleCurrent2hWindow();
}

double shiftGrade =
    crusherOreTons > 0
    ? crusherMetalTons / crusherOreTons
    : 0.0;

double shiftGap =
    crusherOreTons > 0
    ? targetGrade - shiftGrade
    : targetGrade;

pendingGradeShiftReward =
    wGradeShift * gradeReward(shiftGap);

double productionFraction =
    crusherOreTons / targetOreTonsShift;

double productionShortfall =
    clip(1.0 - productionFraction, 0.0, 1.0);

pendingProductionReward =
    -wProduction * productionShortfall;

double cumulativeWait = getCumulativeWaitVehicleSeconds();
double deltaWaitVehicleSeconds = Math.max(
    0.0,
    cumulativeWait - lastWaitVehicleSeconds
);

double waitReward = -wWait * clip(
    (deltaWaitVehicleSeconds / Math.max(1, trucks.size()))
        / waitRefSeconds,
    0.0,
    1.0
);

double finalReward =
    waitReward
    + pendingGradeActionReward
    + pendingGrade2hReward
    + pendingGradeShiftReward
    + pendingProductionReward;
      
Observation terminalObs = lastDispatchObservation;

if (terminalObs == null) {
    if (trucks.isEmpty()) {
        throw new IllegalStateException(
            "No observation available for terminal request"
        );
    }
    terminalObs = buildObservation(trucks.get(0));
}

long seq = decisionSequence++;

DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(-1)
    .setObs(terminalObs)
    .setEpisodeId(episodeId)
    .setDecisionSequence(seq)
    .setRequestId(episodeId + "-" + seq)
    .setKind(DispatchKind.EPISODE_END)
    .setActionRequired(false)
    .setPreviousAction(previousAction)
    .setTransitionReward(finalReward)
    .putRewardComponents("wait", waitReward)
    .putRewardComponents("grade_2h", pendingGrade2hReward)
    .putRewardComponents("grade_shift", pendingGradeShiftReward)
    .putRewardComponents("production", pendingProductionReward)
    .putRewardComponents(
        "delta_wait_vehicle_seconds",
        deltaWaitVehicleSeconds
    )
    .putRewardComponents("shift_grade", shiftGrade)
	.putRewardComponents("grade_gap_shift", shiftGap)
	.putRewardComponents(
	    "grade_shift_reward_raw",
	    gradeReward(shiftGap)
	)
	.putRewardComponents(
	    "production_fraction_raw",
	    productionFraction
	)
	.putRewardComponents("ore_tons_shift", crusherOreTons)
    .setSimTimeSeconds(nowSec)
    .setSimTimeDeltaSeconds(
        Math.max(0.0, nowSec - lastDecisionTimeSec)
    )
	.putRewardComponents(
	    "grade_action",
	    pendingGradeActionReward
	)
	.putRewardComponents(
	    "production_shortfall",
	    productionShortfall
	)
    .setTerminated(true)
    .setTruncated(false)
    .build();

rlClient.getDispatchResult(request);

episodeClosed = true;
getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790412193114</Id>
					<Name><![CDATA[recordWaitAuditCheckpoint]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>-700</X><Y>-800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[label]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// void recordWaitAuditCheckpoint(String label)
double currentCumulativeSeconds =
    getCumulativeWaitVehicleSeconds();

if (!waitAuditInitialized) {
    waitAuditBaselineSeconds = currentCumulativeSeconds;
    waitAuditLastCumulativeSeconds = currentCumulativeSeconds;
    waitAuditDeltaSumSeconds = 0.0;
    waitAuditInitialized = true;

    traceln(
        "[WAIT_DELTA_AUDIT_INIT]"
        + " label=" + label
        + " timeSec=" + time(SECOND)
        + " baselineSec=" + waitAuditBaselineSeconds
    );

    return;
}

double deltaSeconds =
    currentCumulativeSeconds
    - waitAuditLastCumulativeSeconds;

if (deltaSeconds < -1e-6) {
    throw new IllegalStateException(
        "Cumulative waiting time decreased: "
        + " previous=" + waitAuditLastCumulativeSeconds
        + ", current=" + currentCumulativeSeconds
    );
}

deltaSeconds = Math.max(0.0, deltaSeconds);
waitAuditDeltaSumSeconds += deltaSeconds;
waitAuditLastCumulativeSeconds = currentCumulativeSeconds;

traceln(
    "[WAIT_DELTA_AUDIT_STEP]"
    + " label=" + label
    + " policy=" + currentDispatchPolicy
    + " timeSec=" + time(SECOND)
    + " deltaSec=" + deltaSeconds
    + " deltaSumSec=" + waitAuditDeltaSumSeconds
    + " cumulativeSec=" + currentCumulativeSeconds
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790420964895</Id>
					<Name><![CDATA[gradeDeviation]]></Name>
					<X>-450</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(gap)) {
    return 3.0;
}

// gap < 0：实际品位高于0.25，允许到-0.02
// gap > 0：实际品位低于0.25，允许到+0.01
double deviation =
    gap < 0.0
    ? (-gap / 0.02)
    : (gap / 0.01);

// 防止异常品位产生过大的动作奖励
return clip(deviation, 0.0, 3.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790420996711</Id>
					<Name><![CDATA[calculateGradeActionReward]]></Name>
					<X>-450</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[LoadSite site = getLoadSiteById(action);

if (site == null) {
    return 0.0;
}

if (!site.isOre) {
    double shiftProgress =
        clip(time(SECOND) / rlShiftSeconds, 0.0, 1.0);

    double productionProgress =
        clip(
            crusherOreTons / targetOreTonsShift,
            0.0,
            1.0
        );

    double productionLag =
        shiftProgress - productionProgress;

    // 产量进度没有落后时允许选择WASTE；
    // 落后超过5%时，WASTE受到完整惩罚。
    double lagFactor = clip(
        productionLag / productionLagTolerance,
        0.0,
        1.0
    );

    return -wWasteLag * lagFactor;
}

double expectedTons = Math.max(1.0, t.capacity);
double priorTons = Math.max(gradePriorTons, expectedTons);

// --------------------------------------------------
// 1. 当前2小时窗口的反事实品位变化
// 使用目标品位的虚拟初始矿量，避免窗口初期一辆车
// 就把品位从0.25跳到0.38或0.15。
// --------------------------------------------------

double windowTonsBefore = windowOreTons + priorTons;
double windowMetalBefore =
    windowMetalTons + priorTons * targetGrade;

double windowGradeBefore =
    windowMetalBefore / windowTonsBefore;

double windowGapBefore =
    targetGrade - windowGradeBefore;

double windowTonsAfter =
    windowTonsBefore + expectedTons;

double windowMetalAfter =
    windowMetalBefore + expectedTons * site.grade;

double windowGradeAfter =
    windowMetalAfter / windowTonsAfter;

double windowGapAfter =
    targetGrade - windowGradeAfter;

double windowImprovement =
    gradeDeviation(windowGapBefore)
    - gradeDeviation(windowGapAfter);

windowImprovement = clip(
    windowImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// --------------------------------------------------
// 2. 班次累计品位的反事实变化
// --------------------------------------------------

double shiftTonsBefore =
    crusherOreTons + priorTons;

double shiftMetalBefore =
    crusherMetalTons + priorTons * targetGrade;

double shiftGradeBefore =
    shiftMetalBefore / shiftTonsBefore;

double shiftGapBefore =
    targetGrade - shiftGradeBefore;

double shiftTonsAfter =
    shiftTonsBefore + expectedTons;

double shiftMetalAfter =
    shiftMetalBefore + expectedTons * site.grade;

double shiftGradeAfter =
    shiftMetalAfter / shiftTonsAfter;

double shiftGapAfter =
    targetGrade - shiftGradeAfter;

double shiftImprovement =
    gradeDeviation(shiftGapBefore)
    - gradeDeviation(shiftGapAfter);

shiftImprovement = clip(
    shiftImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// 当前窗口更重要，班次累计用于防止窗口间抵消
double rawReward =
    0.70 * windowImprovement
    + 0.30 * shiftImprovement;

return wGradeAction * rawReward;]]></Body>
				</Function>
			</Functions>
