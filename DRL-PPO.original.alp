				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782802968408</Id>
					<Name><![CDATA[prepareRoute]]></Name>
					<X>1560</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destination]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[currentNode = start;
destinationNode = destination;
currentRouteNodes = main.routeNodeMap.get(start + "_" + destination);
currentRouteSegments = main.getRouteSegments(start, destination);
currentRouteKey = start + "_" + destination;
if (currentRouteNodes == null || currentRouteSegments == null || currentRouteSegments.size() == 0) {
    //traceln("Truck " + truckId + " route not found: " + start + " -> " + destination);
    return;
}

currentSegmentIndex = 0;
currentSegment = currentRouteSegments.get(currentSegmentIndex);
laneEntrySeq = main.nextLaneEntrySeq++;

// 当前方向由 PathSegment 给 Truck
direction = currentSegment.direction;
//traceln("当前的方向是: " + direction);

// 当前节点和目标节点编号
currentNodeId = main.destinationToInt(main.getRoadPointNode(currentNode));
targetNodeName = currentSegment.to;
targetNodeId = main.destinationToInt(main.getRoadPointNode(targetNodeName));

// 当前路段长度与距离
remainingDistanceOnSegment = currentSegment.length;
remainingDistanceToDestination = calculateDisToDes();

// 记录当前路段起点和终点坐标

/*traceln("Truck " + truckId + " route prepared: " 
    + start + " -> " + destination 
    + ", first segment: " + currentSegment.from + " -> " + currentSegment.to);
    */]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783068232576</Id>
					<Name><![CDATA[calculateDisOnSeg]]></Name>
					<X>1680</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (targetNodeName == null || targetNodeName.equals("")) {
    return 0;
}

PointNode targetNode = main.getRoadPointNode(targetNodeName);

if (targetNode == null) {
    traceln("Truck " + truckId + " targetNode not found: " + targetNodeName);
    return 0;
}

Point currentPos = new Point(this.getX(), this.getY());
Point targetPos  = new Point(targetNode.getX(), targetNode.getY());

ContinuousShortestPathData out = new ContinuousShortestPathData();
main.network.getPathData(currentPos, targetPos, out);

return out.distance;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783069578929</Id>
					<Name><![CDATA[calculateDisToDes]]></Name>
					<X>1690</X><Y>930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
if (currentSegment == null || currentRouteSegments == null || currentRouteSegments.size() == 0) {
    return 0;
}
*/
double total = remainingDistanceOnSegment;

for (int i = currentSegmentIndex + 1; i < currentRouteSegments.size(); i++) {
    total += currentRouteSegments.get(i).length;
}

return total;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783308773366</Id>
					<Name><![CDATA[calcTTA]]></Name>
					<X>1180</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dist]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speed]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (dist <= 0) {
    return 0;
}

if (speed <= minSpeedForTTA) {
    return maxTTA;
}

return dist / speed;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783321689250</Id>
					<Name><![CDATA[updateBasicSpeedState]]></Name>
					<X>1100</X><Y>1020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    egoSpeed = getSpeed();
} catch (Exception e) {
    egoSpeed = 0;
}

try {
    disToInt = calculateDisOnSeg();
} catch (Exception e) {
    disToInt = 0;
}

tta = calcTTA(disToInt, egoSpeed);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783906367599</Id>
					<Name><![CDATA[onLoadingFinished]]></Name>
					<X>130</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ls]]></Name>
						<Type><![CDATA[LoadSite]]></Type>
					</Parameter>
					<Body><![CDATA[isLoaded = true;
loadFinishedFlag = true;
hasEnteredCurrentProcess = false;
payloadTons = capacity;
if( targetShovel != null){
    payloadIsOre = targetShovel.isOre;
    payloadGrade = targetShovel.grade;
    targetShovel.remainingTons -= payloadTons;
    targetShovel.producedTons += payloadTons;
    targetShovel.busy = false;
}
currentNode = destinationNode;
traceln("Truck " + truckId
    + " loading finished at " + ls.siteName);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783927117311</Id>
					<Name><![CDATA[onDumpingFinished]]></Name>
					<X>-20</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ds]]></Name>
						<Type><![CDATA[DumpSite]]></Type>
					</Parameter>
					<Body><![CDATA[targetDump = ds;
isLoaded = false;
dumpFinishedFlag = true;
hasEnteredCurrentProcess = false;

DumpSite d = main.getDumpSiteById(currentDumpSiteId);
double nowSec = time(SECOND);

if (d == null) {
    throw new IllegalStateException(
        "Unknown dump site: " + currentDumpSiteId
    );
}

// [0, 28800)，28800 秒恰好完成的卸载不计入本班
if (nowSec < main.rlShiftSeconds) {
    if (payloadIsOre && d.acceptsOre && d.siteId == 0) {
        main.totalProduction += payloadTons;
        main.updateCrusherGrade(payloadTons, payloadGrade);
        d.receivedTons += payloadTons;
    } else if (!payloadIsOre && d.acceptsWaste) {
        main.totalWasteMoved += payloadTons;
        d.receivedTons += payloadTons;
    }
}

d.busy = false;

isLoaded = false;
payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;

executionPhase = "COMPLETED";

if (
    currentLegToSiteId != null
    && !currentLegToSiteId.isBlank()
) {
    currentBusinessSiteId = currentLegToSiteId;
}

nextSiteId = null;
debugLastAction = "FinishDump";
currentNode = destinationNode;]]></Body>
				</Function>
