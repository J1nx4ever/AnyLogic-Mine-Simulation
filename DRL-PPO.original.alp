						<Name><![CDATA[timeSpent]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// 1. 服务次数加 1
serviceCount++;

// 2. 将本次循环时间记录到数据集中
dsCycleTime.add( timeSpent );

// 3. 如果加了统计组，同时更新统计组
statCycleTime.add( timeSpent );]]></Body>
