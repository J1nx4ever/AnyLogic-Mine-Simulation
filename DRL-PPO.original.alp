			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776760451396</Id>
					<Name><![CDATA[initTruck]]></Name>
					<X>880</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[truckId = id;
capacity = cap;

currentLoadSiteId = -1;
currentDumpSiteId = -1;

isLoaded = false;
payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;

targetLoadSiteId = -1;
targetDumpSiteId = -1;

cycleStartTime = time();
dispatchTime = 0.0;
arrivalTime = 0.0;
queueEnterTime = 0.0;
loadStartTime = 0.0;
loadFinishTime = 0.0;

currentTravelTime = 0.0;
currentWaitTime = 0.0;
currentCycleTime = 0.0;

// 展示遥测必须在每次 Truck 初始化时复位。
executionPhase = "IDLE";
currentBusinessSiteId = "PARKING";
currentLegFromSiteId = null;
currentLegToSiteId = null;
nextSiteId = null;
activeDecisionId = "";
pendingDecisionId = "";
targetSiteBusinessId = null;

debugLastAction = "init";
emptyFreeSpeedFactor =
    main.sampleTruncatedNormalFactor(
        1.0,
        main.freeSpeedFactorStd,
        main.freeSpeedFactorMin,
        main.freeSpeedFactorMax
    );

loadedFreeSpeedFactor =
    main.sampleTruncatedNormalFactor(
        1.0,
        main.freeSpeedFactorStd,
        main.freeSpeedFactorMin,
        main.freeSpeedFactorMax
    );

freeSpeed = 0.0;
speedRegime = "FREE";
dynamicAccel = 0.0;]]></Body>
				</Function>
