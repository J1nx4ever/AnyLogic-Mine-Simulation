			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776756420025</Id>
					<Name><![CDATA[init1]]></Name>
					<X>280</X><Y>-560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ---------- 初始化 LoadSite population ----------

dynamic = true;

LoadSite s0 = add_loadSites();
s0.setLocation(ShovelOreHigh1);
s0.loadNode = ShovelOreHigh1;
s0.initLoadSite(0, "HG1", true,0.38, 100000, 0.483,ShovelOreHigh1.getX(),ShovelOreHigh1.getY(),12, 1.6);


LoadSite s1 = add_loadSites();
s1.setLocation(ShovelOreHigh2);
s1.loadNode = ShovelOreHigh2;
s1.initLoadSite(1, "HG2", true, 0.3, 100000, 0.483,ShovelOreHigh2.getX(),ShovelOreHigh2.getY(), 12, 1.6);


LoadSite s2 = add_loadSites();
s2.setLocation(ShovelOreLow);
s2.loadNode = ShovelOreLow;
s2.initLoadSite(2, "LG", true, 0.15, 100000, 0.483,ShovelOreLow.getX(),ShovelOreLow.getY(),12, 1.6);

LoadSite s3 = add_loadSites();
s3.setLocation(ShovelWaste);
s3.loadNode = ShovelWaste;
s3.initLoadSite(3, "WASTE", false, 0.00, 100000, 0.483 ,ShovelWaste.getX(),ShovelWaste.getY(),12, 1.6);

for(LoadSite s: loadSites){

    layoutEntities.add(
        new LayoutEntity(
            s.siteName,
            "LOAD_SITE",
            s.getX(),
            s.getY()
        )
    );

}

// ---------- 初始化 DumpSite population ----------

DumpSite d0 = add_dumpSites();
d0.setLocation(Crusher);
d0.dumpNode = Crusher;
d0.initDumpSite(0, "Crusher", true, false, 2.5);

DumpSite d1 = add_dumpSites();
d1.setLocation(dumpNode);
d1.dumpNode = dumpNode;
d1.initDumpSite(1, "Dump", false, true, 2.0);


for(DumpSite d: dumpSites){

    layoutEntities.add(
        new LayoutEntity(
            d.siteName,
            "DUMP_SITE",
            d.getX(),
            d.getY()
        )
    );

}

// ---------- 初始化 Truck population ----------

//init_trucks(numTrucks);
for(int i = 0; i < numTrucks; i++){

    Truck t = add_trucks();
    t.delay = i * 1;
    if(i <(0.5 * numTrucks)){
    	t.setLocation(collectionTrucks.get(i+25));
    	t.currentNode = "dumpNode";
    	t.startPoint = t.currentNode;
    }else{
        t.setLocation(collectionTrucks.get(i+5));
        t.currentNode = "Crusher";
        t.startPoint = t.currentNode;
    }

    if (dynamic == false){
    	t.targetShovel = getLoadSiteById(0);
    }
	/*
	t.setLocation(collectionTrucks.get(i+15));
	t.currentNode = "Crusher";
	t.startPoint = t.currentNode;
	*/
    t.setSpeed(25,KPH);
    t.initTruck(i, truckCapacity);
    t.deliver("ACTIVATE", t);

}
// ---------- 初始化 Stats population ----------

for(int i = 0; i < 4 ; i++ ){
	loadingPointStatsList.get(i).loadingPointName = collectionLoadSites.get(i).getName();
}





// ---------- 初始化全局统计 ----------
crusherOreTons = 0;
crusherMetalTons = 0;
currentFeedGrade = 0;
gradeGap = targetGrade - currentFeedGrade;

totalProduction = 0;
totalWasteMoved = 0;
totalWaitTime = 0;
totalTravelTime = 0;
totalCycleTime = 0;
completedTrips = 0;

L2DList = L2D();



]]></Body>
				</Function>
