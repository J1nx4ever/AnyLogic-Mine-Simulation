					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double probInit1 = 0.5; // 可调
if (Math.random() < probInit1) {
    this.init1();
    traceln("【RL 泛化环境】本回合初始化为：环境 1 (常规品位配置)");
} else {
    this.init2();
    traceln("【RL 泛化环境】本回合初始化为：环境 2 (调换品位配置)");
}]]></Body>
				</Function>
