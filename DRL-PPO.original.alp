				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782719140686</Id>
					<Name><![CDATA[addBidirectionalPath]]></Name>
					<X>140</X><Y>-450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[positiveFrom]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[positiveTo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speedLimit]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// 正向：卸载点 / crusher / dump → loadSite
PathSegment forwardSeg = new PathSegment(
    this,
    positiveFrom,
    positiveTo,
    positiveFrom,
    positiveTo,
    speedLimit
);
// 反向：loadSite → 卸载点 / crusher / dump
PathSegment reverseSeg = new PathSegment(
    this,
    positiveTo,
    positiveFrom,
    positiveFrom,
    positiveTo,
    speedLimit
);

segmentMap.put(forwardSeg.key, forwardSeg);
segmentMap.put(reverseSeg.key, reverseSeg);

traceln("Add path: " 
    + forwardSeg.key + " dir=" + forwardSeg.directionName 
    + ", " 
    + reverseSeg.key + " dir=" + reverseSeg.directionName);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782720009982</Id>
					<Name><![CDATA[init_routeNodeMap]]></Name>
					<X>-60</X><Y>-450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
// 初始化所有路径（4条正向 + 4条反向 = 8条）
addBidirectionalRoute("cCrusher_loadSite1", "Crusher", "intersection1", "intersection2", "intersection3", "ShovelOreHigh1");
addBidirectionalRoute("crusher_loadSite2", "Crusher", "intersection1", "intersection2", "intersection3", "ShovelOreHigh2");
addBidirectionalRoute("crusher_loadSiteLow", "Crusher", "intersection1", "intersection2", "intersection3", "ShovelOreLow");
addBidirectionalRoute("crusher_wasteSite", "Crusher", "intersection1", "intersection2", "ShovelWaste");
addBidirectionalRoute("dumpNode_wasteSite", "dumpNode", "intersection2", "ShovelWaste");
*/
traceln("开始初始化路径网络...");
traceln("");

addBidirectionalRoute("Crusher_ShovelOreHigh2", "Crusher", "intersection1", "intersection2", "intersection3", "ShovelOreHigh2");
addBidirectionalRoute("Crusher_ShovelOreHigh1", "Crusher", "intersection1", "intersection2", "ShovelOreHigh1");
addBidirectionalRoute("Crusher_ShovelOreLow", "Crusher", "intersection1", "intersection2", "intersection3", "ShovelOreLow");
addBidirectionalRoute("Crusher_ShovelWaste", "Crusher", "intersection1", "intersection2", "ShovelWaste");
addBidirectionalRoute("dumpNode_ShovelWaste", "dumpNode", "intersection2", "ShovelWaste");
addBidirectionalRoute("dumpNode_ShovelOreHigh2", "dumpNode","intersection2", "intersection3", "ShovelOreHigh2");
addBidirectionalRoute("dumpNode_ShovelOreLow", "dumpNode","intersection2", "intersection3", "ShovelOreLow");
addBidirectionalRoute("dumpNode_ShovelOreHigh1", "dumpNode","intersection2", "ShovelOreHigh1");
traceln("========================================");
traceln("路径初始化完成！总共 " + routeNodeMap.size() + " 条路径");
traceln("========================================");

// 打印所有路径
for (String key : routeNodeMap.keySet()) {
    traceln(key + " → " + routeNodeMap.get(key));
}
traceln("========================================");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782720249646</Id>
					<Name><![CDATA[addBidirectionalRoute]]></Name>
					<X>-60</X><Y>-420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nodes]]></Name>
						<Type><![CDATA[String...]]></Type>
					</Parameter>
					<Body><![CDATA[
// 正方向
routeNodeMap.put(key, new ArrayList<>(Arrays.asList(nodes)));

// 反方向
String[] parts = key.split("_");
String reverseKey = parts[1] + "_" + parts[0];
ArrayList<String> reversePath = new ArrayList<>(Arrays.asList(nodes));
Collections.reverse(reversePath);
routeNodeMap.put(reverseKey, reversePath);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<PathSegment>]]></ReturnType>
					<Id>1782800603028</Id>
					<Name><![CDATA[getRouteSegments]]></Name>
					<X>140</X><Y>-390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[end]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String routeKey = start + "_" + end;

ArrayList<String> nodes = routeNodeMap.get(routeKey);
ArrayList<PathSegment> segments = new ArrayList<>();

if (nodes == null) {
    traceln("No route found: " + routeKey);
    return segments;
}

for (int i = 0; i < nodes.size() - 1; i++) {
    String from = nodes.get(i);
    String to = nodes.get(i + 1);
    String segKey = from + "_" + to;

    PathSegment seg = segmentMap.get(segKey);

    if (seg == null) {
        traceln("No segment found: " + segKey);
    } else {
        segments.add(seg);
    }
}
return segments;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
