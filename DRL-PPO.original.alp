				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[][]]]></ReturnType>
					<Id>1776855589565</Id>
					<Name><![CDATA[L2D]]></Name>
					<X>660</X><Y>-460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[][] L2DList = new double[2][4];


for (int i = 0; i < collectionDumpSites.size(); i++){
	for(int j = 0; j < collectionLoadSites.size(); j++){
		L2DList[i][j] = DistanceRecorder(collectionDumpSites.get(i).getX(),collectionDumpSites.get(i).getY(),
		collectionLoadSites.get(j).getX(),collectionLoadSites.get(j).getY());
		traceln(collectionDumpSites.get(i).getName() + "到" + collectionLoadSites.get(j).getName() 
		+ "的距离：" + L2DList[i][j]  + "m");
	}
}
return (L2DList);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Observation]]></ReturnType>
					<Id>1776929430864</Id>
					<Name><![CDATA[buildObservation]]></Name>
					<X>920</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) {
    throw new IllegalArgumentException("truck is required");
}

double fleet = trucks.size();
if (fleet <= 0 || targetOreTons2h <= 0 || targetOreTonsShift <= 0) {
    throw new IllegalStateException("Invalid observation denominator");
}

advanceCompletedGradeWindows(time(SECOND));

double nowSec = Math.min(time(SECOND), rlShiftSeconds);

double grade2h =
    windowOreTons > 0
    ? windowMetalTons / windowOreTons
    : 0.0;

double gradeGap2hNorm =
    windowOreTons > 0
    ? clip((targetGrade - grade2h) / 0.15, -1.0, 1.0)
    : 0.0;

double gradeGapShiftNorm =
    crusherOreTons > 0
    ? clip((targetGrade - currentFeedGrade) / 0.15, -1.0, 1.0)
    : 0.0;

double windowStartSec =
    Math.min(currentWindowIndex, 3) * rlWindowSeconds;

double[] x = new double[27];

x[0] = gradeGap2hNorm;
x[1] = clip(windowOreTons / targetOreTons2h, 0.0, 1.0);
x[2] = clip(
    (nowSec - windowStartSec) / rlWindowSeconds,
    0.0,
    1.0
);

x[3] = gradeGapShiftNorm;
x[4] = clip(crusherOreTons / targetOreTonsShift, 0.0, 1.0);
x[5] = clip(nowSec / rlShiftSeconds, 0.0, 1.0);

// 必须按 siteId 0/1/2/3，而不是 population 当前遍历顺序
for (int siteId = 0; siteId < 4; siteId++) {
    LoadSite s = getLoadSiteById(siteId);
    if (s == null) {
        throw new IllegalStateException(
            "Missing LoadSite siteId=" + siteId
        );
    }

    int base = 6 + siteId * 3;
    x[base]     = clip(s.getQueueSize() / fleet, 0.0, 1.0);
    x[base + 1] = clip(s.incomingTrucks / fleet, 0.0, 1.0);
    x[base + 2] = s.getUtilization();
}

int crusherIncoming = 0;
int dumpIncoming = 0;

for (Truck other : trucks) {
    if (other.isLoaded && "TO_DUMP".equals(other.executionPhase)) {
        if (other.targetDumpSiteId == 0) crusherIncoming++;
        if (other.targetDumpSiteId == 1) dumpIncoming++;
    }
}

DumpSite crusher = getDumpSiteById(0);
DumpSite dump = getDumpSiteById(1);

x[18] = clip(crusher.getQueueSize() / fleet, 0.0, 1.0);
x[19] = clip(crusherIncoming / fleet, 0.0, 1.0);
x[20] = crusher.getUtilization();

x[21] = clip(dump.getQueueSize() / fleet, 0.0, 1.0);
x[22] = clip(dumpIncoming / fleet, 0.0, 1.0);
x[23] = dump.getUtilization();

// origin_initial, origin_crusher, origin_dump
x[24] = t.currentDumpSiteId < 0 ? 1.0 : 0.0;
x[25] = t.currentDumpSiteId == 0 ? 1.0 : 0.0;
x[26] = t.currentDumpSiteId == 1 ? 1.0 : 0.0;

Observation.Builder builder = Observation.newBuilder()
    .setSchemaId("dispatch.v1-27");

for (int i = 0; i < x.length; i++) {
    if (!Double.isFinite(x[i])) {
        throw new IllegalStateException(
            "Non-finite observation[" + i + "]=" + x[i]
        );
    }
    builder.addValues((float) x[i]);
}

return builder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776930047603</Id>
					<Name><![CDATA[getCrusherOreTonsNorm]]></Name>
					<X>1280</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return crusherOreTons / 100000;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776930067715</Id>
					<Name><![CDATA[getProgress]]></Name>
					<X>1280</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double formalMinutes = time(MINUTE) - warmUpTime;

if (formalMinutes <= 0) {
    return 0;
}

return Math.min(1.0, formalMinutes / shiftDuration);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776934595976</Id>
					<Name><![CDATA[selectNextLoadSiteAI]]></Name>
					<X>660</X><Y>-680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !enableOnnxDispatch
    || rlClient == null
    || !rlClient.isReady()
) {
    throw new IllegalStateException(
        "Dispatch training client is unavailable"
    );
}

Observation obs = buildObservation(t);
double nowSec = time(SECOND);

boolean isStart = !episodeStarted;

double deltaWaitVehicleSeconds = 0.0;
double waitReward = 0.0;
double simDeltaSeconds = 0.0;

if (!isStart) {
    double cumulativeWait = getCumulativeWaitVehicleSeconds();

    deltaWaitVehicleSeconds = Math.max(
        0.0,
        cumulativeWait - lastWaitVehicleSeconds
    );

    double meanWaitPerTruck =
        deltaWaitVehicleSeconds / Math.max(1, trucks.size());

	waitReward = -wWait * clip(
	    meanWaitPerTruck / waitRefSeconds,
	    0.0,
	    1.0
	);

    simDeltaSeconds = Math.max(0.0, nowSec - lastDecisionTimeSec);
}

double transitionReward =
    isStart
    ? 0.0
    : waitReward
        + pendingGradeActionReward
        + pendingGrade2hReward
        + pendingGradeShiftReward
        + pendingProductionReward;

long seq = decisionSequence++;
String requestId = episodeId + "-" + seq;

DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(t.truckId)
    .setObs(obs)
    .setEpisodeId(episodeId)
    .setDecisionSequence(seq)
    .setRequestId(requestId)
    .setKind(
        isStart
        ? DispatchKind.EPISODE_START
        : DispatchKind.DECISION
    )
    .setActionRequired(true)
    .setPreviousAction(isStart ? -1 : previousAction)
    .setTransitionReward(transitionReward)
    .putRewardComponents("wait", isStart ? 0.0 : waitReward)
    .putRewardComponents("grade_2h", pendingGrade2hReward)
    .putRewardComponents("grade_shift", pendingGradeShiftReward)
    .putRewardComponents("production", pendingProductionReward)
    .putRewardComponents(
        "delta_wait_vehicle_seconds",
        deltaWaitVehicleSeconds
    )
    .putRewardComponents(
	    "grade_action",
	    isStart ? 0.0 : pendingGradeActionReward
	)
    .setSimTimeSeconds(nowSec)
    .setSimTimeDeltaSeconds(simDeltaSeconds)
    .setTerminated(false)
    .setTruncated(false)
    .build();

DispatchResponse response = rlClient.getDispatchResult(request);

if (!response.getHasAction()) {
    throw new IllegalStateException(
        "Dispatch response has_action=false for action request"
    );
}

int action = response.getAction();
if (action < 0 || action > 3 || getLoadSiteById(action) == null) {
    throw new IllegalStateException("Invalid dispatch action: " + action);
}
double nextGradeActionReward =
    calculateGradeActionReward(t, action);

// 只有 RPC 成功后才消费 reward，避免异常时丢失
episodeStarted = true;
previousAction = action;
lastDispatchObservation = obs;
lastWaitVehicleSeconds = getCumulativeWaitVehicleSeconds();
lastDecisionTimeSec = nowSec;

// 当前request已经成功发送，消费上一transition的奖励
pendingGradeActionReward = 0.0;
pendingGrade2hReward = 0.0;
pendingGradeShiftReward = 0.0;
pendingProductionReward = 0.0;

// 当前action的品位奖励属于 action -> next state，
// 留到下一次DECISION或EPISODE_END返回
pendingGradeActionReward = nextGradeActionReward;

return action;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781763277868</Id>
					<Name><![CDATA[init2]]></Name>
					<X>280</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ---------- 初始化 LoadSite population ----------

dynamic = true;

LoadSite s0 = add_loadSites();
s0.setLocation(ShovelOreHigh1);
s0.initLoadSite(0, "High1", true,0.38, 100000, 0.483,ShovelOreHigh1.getX(),ShovelOreHigh1.getY(),12, 1.6);

LoadSite s1 = add_loadSites();
s1.setLocation(ShovelOreHigh2);
s1.initLoadSite(1, "High2", true, 0.3, 100000, 0.483,ShovelOreHigh2.getX(),ShovelOreHigh2.getY(), 12, 1.6);

LoadSite s2 = add_loadSites();
s2.setLocation(ShovelOreLow);
s2.initLoadSite(2, "Low", true, 0.15, 100000, 0.483,ShovelOreLow.getX(),ShovelOreLow.getY(),12, 1.6);

LoadSite s3 = add_loadSites();
s3.setLocation(ShovelWaste);
s3.initLoadSite(3, "Waste", false, 0.00, 100000, 0.483 ,ShovelWaste.getX(),ShovelWaste.getY(),12, 1.6);

// ---------- 初始化 DumpSite population ----------

DumpSite d0 = add_dumpSites();
d0.setLocation(Crusher);
d0.initDumpSite(0, "Crusher", true, false, 2.5);

DumpSite d1 = add_dumpSites();
d1.setLocation(dumpNode);
d1.initDumpSite(1, "Dump", false, true, 2.0);

// ---------- 初始化 Truck population ----------


for(int i = 0; i < numTrucks; i++){

    Truck t = add_trucks();
    t.delay = i * 10;
    if(i % 4 == 3){
    	t.setLocation(dumpNode);
    }else{
        t.setLocation(collectionTrucks.get(i+15));
    }

    if (dynamic == false){
    	t.targetShovel = getLoadSiteById(i%4);
    }
    t.setSpeed(25,KPH);
    t.initTruck(i, truckCapacity);
    t.deliver("ACTIVATE", t);

}
// ---------- 初始化 Stats population ----------

for(int i = 0; i < 4 ; i++ ){
	loadingPointStatsList.get(i).loadingPointName = collectionLoadSites.get(i).getName();
}





// ---------- 初始化全局统计 ----------
crusherOreTons = 0;
crusherMetalTons = 0;
currentFeedGrade = 0;
gradeGap = targetGrade - currentFeedGrade;

totalProduction = 0;
totalWasteMoved = 0;
totalWaitTime = 0;
totalTravelTime = 0;
totalCycleTime = 0;
completedTrips = 0;

P2LList = P2L();
P2DList = P2D();
L2DList = L2D();



]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781776065859</Id>
					<Name><![CDATA[randomTest]]></Name>
					<X>280</X><Y>-630</Y>
