				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1776758742501</Id>
					<Name><![CDATA[updateCrusherGrade]]></Name>
					<X>440</X><Y>-390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tons]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[grade]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double nowSec = time(SECOND);

// 保证恰好发生在 7200/14400/21600 秒的收料进入新窗口
advanceCompletedGradeWindows(nowSec);

// 28800 秒及之后不再计入本班
if (nowSec >= rlShiftSeconds) {
    return;
}

if (tons <= 0 || !Double.isFinite(tons) || !Double.isFinite(grade)) {
    throw new IllegalArgumentException(
        "Invalid crusher delivery: tons=" + tons + ", grade=" + grade
    );
}

crusherOreTons += tons;
crusherMetalTons += tons * grade;

windowOreTons += tons;
windowMetalTons += tons * grade;

currentFeedGrade = crusherMetalTons > 0
    ? crusherMetalTons / crusherOreTons
    : 0.0;

gradeGap = targetGrade - currentFeedGrade;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758834191</Id>
					<Name><![CDATA[selectNextLoadSiteRandom]]></Name>
					<X>660</X><Y>-640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[return uniform_discr(0, loadSites.size() - 1);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758872990</Id>
					<Name><![CDATA[selectNextLoadSiteSQ]]></Name>
					<X>660</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[int bestId = -1;
double bestScore = Double.MAX_VALUE;

for (LoadSite s : loadSites) {
    if (!s.available) continue;

    double score = s.queue.size()+ s.incomingTrucks;
    if (score < bestScore) {
        bestScore = score;
        bestId = s.siteId;
    }
}
return bestId;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758908335</Id>
					<Name><![CDATA[selectNextLoadSiteGradeAware]]></Name>
					<X>660</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[// 初始化最佳装载点和对应的最小车辆数
LoadSite bestPoint = null;
int minTrucks = Integer.MAX_VALUE;

// 1. 确定品位倾向：当前品位低则寻找高品位，当前品位高则寻找低品位
// 假设有一个基准品位 targetGrade，或者直接对比当前品位与装载点的品位关系
// 这里逻辑：如果当前偏低，我们倾向于找品位 > currentGrade 的；反之找 < currentGrade 的
boolean lookForHigher = currentFeedGrade < targetGrade; // targetGrade 需在模型中定义，例如标准品位

// 2. 第一轮筛选：严格满足品位方向
for (LoadSite lp : loadSites) {
    boolean matchesGradeStrategy = lookForHigher ? (lp.grade > currentFeedGrade) : (lp.grade < currentFeedGrade);
    
    if (matchesGradeStrategy) {
        int totalTrucks = lp.queue.size()+ lp.incomingTrucks; // queue + incoming
        if (totalTrucks < minTrucks) {
            minTrucks = totalTrucks;
            bestPoint = lp;
        }
    }
}
return bestPoint.siteId;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776758939376</Id>
					<Name><![CDATA[selectNextLoadSite]]></Name>
					<X>660</X><Y>-550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[// 所有策略都经过这里，因此审计与 PPO 无关
switch (currentDispatchPolicy) {
    case 0:
        return selectNextLoadSiteRandom(t);

    case 1:
        return selectNextLoadSiteSQ(t);

    case 2:
        return selectNextLoadSiteGradeAware(t);

    case 3:
        return selectNextLoadSiteAI(t);

    default:
        throw new IllegalStateException(
            "Unknown dispatch policy: " + currentDispatchPolicy
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1776855555204</Id>
					<Name><![CDATA[P2L]]></Name>
					<X>660</X><Y>-520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] P2LList =new  double[4];
double sum = 0;
double ave = 0;
for(int i = 0; i < collectionLoadSites.size(); i++){

	P2LList[i] = (DistanceRecorder(parking.getX(), parking.getY(),
	collectionLoadSites.get(i).getX(),collectionLoadSites.get(i).getY()));
	sum += P2LList[i];
}
ave = sum / 4;
traceln("P2L:" + ave);
return P2LList;]]></Body>
				</Function>
