					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[triangular( 0.5, 1, 1.5 )+0.8]]></Code>
								<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

numInService++;

t.loadStartTime = time();

double waitTime = t.loadStartTime - t.queueEnterTime;
if (waitTime < 0) {
    waitTime = 0;
}

t.isWaitingForLoadResource = false;
t.lastLoadWaitTime = waitTime;
t.totalLoadWaitTime += waitTime;

totalQueueTime += waitTime;
main.totalSystemLoadWaitTime += waitTime;
main.totalWaitTime += waitTime;

// Delay 真正开始后才是 LOADING，不能在排队入口提前标记。
t.executionPhase = "LOADING";]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

numInService = Math.max(0, numInService - 1);

t.loadFinishTime = time();

double serviceTime = t.loadFinishTime - t.loadStartTime;
totalServiceTime += serviceTime;

/*traceln("Truck " + t.truckId
    + " finishes loading at " + siteName
    + ", serviceTime=" + serviceTime
    + ", numInService=" + numInService);*/]]></Code>
							</Value>
						</Parameter>
