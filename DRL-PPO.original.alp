					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[for (DumpSite d : main.dumpSites) {
    if (payloadIsOre && d.acceptsOre) {
        targetDumpSiteId = d.siteId;
        break;
    }
    if (!payloadIsOre && d.acceptsWaste) {
        targetDumpSiteId = d.siteId;
        break;
    }
}
legTravelStartTime = time();
legStartSec = time(SECOND);
minGapThisLeg = 9999;
dynamicAccel = 0;
targetDump = main.getDumpSiteById(targetDumpSiteId);
destinationNode = main.collectionDumpSites
    .get(targetDumpSiteId).getName();
intDestination = main.roadNodeNameToInt(destinationNode);

// 将模型内名称规范化为冻结契约中的业务站点 ID。
String dumpBusinessId = null;
if (targetDump != null && targetDump.siteName != null) {
    if ("Crusher".equalsIgnoreCase(targetDump.siteName)) {
        dumpBusinessId = "CRUSHER";
    } else if ("Dump".equalsIgnoreCase(targetDump.siteName)) {
        dumpBusinessId = "DUMP-01";
    } else {
        dumpBusinessId = targetDump.siteName;
    }
}

executionPhase = "TO_DUMP";
currentLegFromSiteId = currentBusinessSiteId;
currentLegToSiteId = dumpBusinessId;
nextSiteId = null;

this.send("TODUMPSITE", this);]]></EntryAction>
