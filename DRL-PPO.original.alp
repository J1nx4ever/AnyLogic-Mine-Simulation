			<Events>
				<Event>
					<Id>1776933162670</Id>
					<Name><![CDATA[endSimulationEvent]]></Name>
					<X>970</X><Y>-810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777017600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[warmUpTime + shiftDuration]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[finishEpisodeAndNotify();]]></Action>
				</Event>
				<Event>
					<Id>1780630320732</Id>
					<Name><![CDATA[endWarmUpEvent]]></Name>
					<X>970</X><Y>-700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="condition" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1780646400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[warmUpTime]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[isWarmUp = false;

totalProduction = 0;
totalWasteMoved = 0;
totalWaitTime = 0;
totalTravelTime = 0;
totalCycleTime = 0;
totalSystemLoadWaitTime = 0;
totalSystemDumpWaitTime = 0;
completedTrips = 0;

crusherOreTons = 0;
crusherMetalTons = 0;
currentFeedGrade = 0;
gradeGap = targetGrade;

for (Truck t : trucks) {
    t.cycleStartTime = time();
    t.totalLoadWaitTime = 0;
    t.totalDumpWaitTime = 0;
    t.lastLoadWaitTime = 0;
    t.lastDumpWaitTime = 0;
}

for (LoadSite s : loadSites) {
    s.producedTons = 0;
    s.totalQueueTime = 0;
    s.totalServiceTime = 0;
    s.totalServed = 0;
}

for (DumpSite d : dumpSites) {
    d.receivedTons = 0;
    d.totalDumpQueueTime = 0;
    d.totalDumpServiceTime = 0;
    d.totalServed = 0;
}]]></Action>
