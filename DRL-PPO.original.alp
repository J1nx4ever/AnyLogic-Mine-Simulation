					</Points>
					<IconOffset>50.0</IconOffset>
					<Properties Source="1776760103701" Target="1783903741711" Trigger="message">
						<Action><![CDATA[hasEnteredCurrentProcess = true;

// 车辆已经到达装载站，随后进入资源等待/装载流程。
executionPhase = "WAITING_LOAD";
if (targetSiteBusinessId != null && !targetSiteBusinessId.isBlank()) {
    currentBusinessSiteId = targetSiteBusinessId;
}

double beforeX = getX();
double beforeY = getY();

traceln(
    "[ENTER_LOAD_BEFORE] truck=" + truckId
    + ", pos=(" + beforeX + "," + beforeY + ")"
    + ", site=" + targetShovel.siteName
);
if (targetShovel == null) {
    throw new IllegalStateException("targetShovel is null on arrival");
}
if (incomingLoadSiteId != targetShovel.siteId) {
    throw new IllegalStateException(
        "Incoming site mismatch: truck=" + truckId
        + ", recorded=" + incomingLoadSiteId
        + ", arrived=" + targetShovel.siteId
    );
}
if (targetShovel.incomingTrucks <= 0) {
    throw new IllegalStateException(
        "incomingTrucks underflow at " + targetShovel.siteName
    );
}

targetShovel.incomingTrucks--;
incomingLoadSiteId = -1;
arrivalTime = time();

currentTravelTime =
    Math.max(0, arrivalTime - legTravelStartTime);

if (!main.isWarmUp) {
    main.totalTravelTime += currentTravelTime;
}
targetShovel.enterLoad.take(this);

double realizedTravelSec =
    time(SECOND) - legStartSec;

traceln(
    "[TRAVEL]"
    + ", truck=" + truckId
    + ", loaded=false"
    + ", from=" + currentLegFromSiteId
    + ", to=" + currentLegToSiteId
    + ", travelSec=" + realizedTravelSec
    + ", minGap=" + minGapThisLeg
);]]></Action>
