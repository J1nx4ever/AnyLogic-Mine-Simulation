				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.ObservationDict]]></ReturnType>
					<Id>1783323980904</Id>
					<Name><![CDATA[buildSpeedObservations]]></Name>
					<X>1280</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[stage]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Fusion.grpc.ObservationDict.Builder dictBuilder =
    Fusion.grpc.ObservationDict.newBuilder();

for (Truck t : trucks) {
    Fusion.grpc.Observation obs =
        Fusion.grpc.Observation.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setState(buildSpeedState(t, stage))
            .build();

    dictBuilder.addObservations(obs);
}

return dictBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.StateData]]></ReturnType>
					<Id>1783324059850</Id>
					<Name><![CDATA[buildSpeedState]]></Name>
					<X>1280</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[stage]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Fusion.grpc.StateData.Builder sb =
    Fusion.grpc.StateData.newBuilder();

double egoSpeed = 0;
double distToInt = 0;
double ttaEgo = 9999;
double prevAccel = 0;
int targetRoadNode = -1;

try {
    egoSpeed = t.getSpeed();
} catch (Exception e) {
    egoSpeed = t.egoSpeed;
}

try {
    distToInt = t.disToInt;
} catch (Exception e) {
    distToInt = 0;
}

if (egoSpeed > 0.1) {
    ttaEgo = distToInt / egoSpeed;
}

try {
    prevAccel = t.prevCmdAccel;
} catch (Exception e) {
    prevAccel = 0;
}

try {
    targetRoadNode = t.targetNodeId;
} catch (Exception e) {
    targetRoadNode = -1;
}

sb.setEgoAgentId(t.truckId);
sb.setTargetRoadNode(targetRoadNode);
sb.setEgoSpeed(egoSpeed);
sb.setDistToInt(distToInt);
sb.setTtaEgo(ttaEgo);
sb.setPrevCmdAccel(prevAccel);

if (stage >= 2) {
    sb.setHasFront(t.hasFront);
    sb.setFrontAgentId(t.front_id);
    sb.setFrontSpeed(t.frontSpeed);
    sb.setFrontDist(t.frontDis);
    sb.setFrontTtc(t.frontTtc);

    sb.setHasRear(t.hasRear);
    sb.setRearAgentId(t.rear_id);
    sb.setRearSpeed(t.rearSpeed);
    sb.setRearDist(t.rearDis);
}

if (stage >= 3) {

    boolean hasConflictNow =
        t.conflict_id != null && t.conflict_id.size() > 0;

    sb.setHasConflict(hasConflictNow);

    if (hasConflictNow) {

        int n = t.conflict_id.size();

        for (int i = 0; i < n; i++) {

            int cid = -1;
            double cSpeed = 0;
            double cEta = 9999;
            double cDist = 9999;

            try {
                cid = t.conflict_id.get(i);
            } catch (Exception e) {
                cid = -1;
            }

            try {
                if (t.conflictSpeed != null && i < t.conflictSpeed.size()) {
                    cSpeed = t.conflictSpeed.get(i);
                }
            } catch (Exception e) {
                cSpeed = 0;
            }

            try {
                if (t.conflictEta != null && i < t.conflictEta.size()) {
                    cEta = t.conflictEta.get(i);
                }
            } catch (Exception e) {
                cEta = 9999;
            }

            try {
                if (t.conflictDist != null && i < t.conflictDist.size()) {
                    cDist = t.conflictDist.get(i);
                }
            } catch (Exception e) {
                cDist = 9999;
            }

            Fusion.grpc.ConflictVehicleInfo conflict =
                Fusion.grpc.ConflictVehicleInfo.newBuilder()
                    .setAgentId(cid)
                    .setConflictSpeed(cSpeed)
                    .setRelativeSpeed(egoSpeed - cSpeed)
                    .setConflictEta(cEta)
                    .setDiffEta(Math.abs(ttaEgo - cEta))
                    .setDiffDist(cDist)
                    .build();

            sb.addConflictVehicles(conflict);
        }
    }
}

return sb.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.StepResponse]]></ReturnType>
					<Id>1783324511170</Id>
					<Name><![CDATA[buildSpeedStepResponse]]></Name>
					<X>1520</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Fusion.grpc.StepResponse.Builder responseBuilder =
    Fusion.grpc.StepResponse.newBuilder();

int count = 0;

for (Truck t : trucks) {

    Fusion.grpc.AgentState agentState =
        Fusion.grpc.AgentState.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setObservation(buildSpeedState(t, 3))
            .setReward(0)
            .setTerminated(false)
            .setTruncated(false)

            .putInfo("truck_id", String.valueOf(t.truckId))
            .putInfo("speed", String.valueOf(t.egoSpeed))
            .putInfo("cmd_accel", String.valueOf(t.cmdAccel))
			.putInfo("x", String.valueOf(t.getX()))
			.putInfo("y", String.valueOf(t.getY()))
			.putInfo("current_node", String.valueOf(t.currentNode))
			.putInfo("target_node", String.valueOf(t.targetNodeName))
			.putInfo("route", String.valueOf(t.currentRouteKey))
			.putInfo("debug_action", String.valueOf(t.debugLastAction))
            .putInfo("target_road_node", String.valueOf(t.targetNodeName))
            .putInfo("dist_to_int", String.valueOf(t.disToInt))
            .putInfo("tta_ego", String.valueOf(t.tta))

            .putInfo("has_front", String.valueOf(t.hasFront))
            .putInfo("front_id", String.valueOf(t.front_id))
            .putInfo("front_dist", String.valueOf(t.frontDis))
            .putInfo("has_rear", String.valueOf(t.hasRear))
            .putInfo("rear_id", String.valueOf(t.rear_id))
            .putInfo("rear_dist", String.valueOf(t.rearDis))

            .putInfo("conflict_node", String.valueOf(t.conflictNodeKey))
            .putInfo("ego_conflict_eta", String.valueOf(t.egoConflictEta))
            .putInfo("ego_conflict_dist", String.valueOf(t.egoConflictDist))
            .putInfo("conflict_count", String.valueOf(
                t.conflict_id == null ? 0 : t.conflict_id.size()
            ))

            .build();

    responseBuilder.addAgents(agentState);
    count++;
}

responseBuilder.setGlobalDone(false);
responseBuilder.putGlobalInfo("time", String.valueOf(time()));
responseBuilder.putGlobalInfo("num_trucks", String.valueOf(trucks.size()));
responseBuilder.putGlobalInfo("agent_count", String.valueOf(count));
responseBuilder.putGlobalInfo("mode", "full_state_test_stage_3");

traceln("[SpeedControl] buildSpeedStepResponse agents=" + count);

return responseBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783324557206</Id>
					<Name><![CDATA[calculateSpeedReward]]></Name>
					<X>1520</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[double reward = 0;

try {
    if (t.is_collision) {
        reward -= 10.0;
    }
} catch (Exception e) {}

try {
    if (t.is_arrived || t.agentDone) {
        reward += 1.0;
    }
} catch (Exception e) {}

try {
    if (t.hasFront  && t.frontDis > 0 && t.frontDis < 10) {
        reward -= (10.0 - t.frontDis) * 0.1;
    }
} catch (Exception e) {}

try {
    reward -= Math.abs(t.cmdAccel) * 0.01;
} catch (Exception e) {}

return reward;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
