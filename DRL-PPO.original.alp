						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!useLocalDynamicSpeed) {
    return;
}

// 先更新车辆自身位置和速度状态
for (Truck t : trucks) {
    t.updateBasicSpeedState();
}

// 再确定同向前后关系
updateFrontRearVehicles();

// 补充跨相邻 segment 的同向前车
updateNextSegmentFrontVehicles();

// 最后同时计算本周期速度
for (Truck t : trucks) {
    applyDynamicSpeed(t,useEndogenousCongestion);
}]]></Action>
