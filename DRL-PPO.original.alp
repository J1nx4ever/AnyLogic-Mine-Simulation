						<TextColor/>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[/*
if (rlClient == null || trucks.isEmpty()) { 
    traceln("No client or real truck"); 
    return; 
}

Truck testTruck = trucks.get(0);
long startedNs = System.nanoTime();

try {
    Observation obs = buildObservation(testTruck);
    DispatchRequest req = DispatchRequest.newBuilder()
        .setTruckId(testTruck.truckId).setObs(obs).build();
    int action = rlClient.getNextDestination(req);
    traceln("Communication OK action=" + action + " latencyUs=" + ((System.nanoTime()-startedNs)/1000L));
} catch (RuntimeException ex) {
    traceln("Communication failed: " + ex.getMessage());
}
*/
traceln(buildLayoutJson());]]></ActionCode>
