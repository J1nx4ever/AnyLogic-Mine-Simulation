			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760074595</Id>
					<Name><![CDATA[IdleAtParking]]></Name>
					<X>590</X><Y>240</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[
currentLoadSiteId = -1;
currentDumpSiteId = -1;

isLoaded = false;
payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;

// 仅供展示的任务遥测。
executionPhase = "IDLE";
currentBusinessSiteId = currentNode;
currentLegFromSiteId = null;
currentLegToSiteId = null;
nextSiteId = null;

debugLastAction = "IdleAtParking";]]></EntryAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760092470</Id>
					<Name><![CDATA[NeedDispatchToLoadSite]]></Name>
					<X>590</X><Y>460</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[legStartSec = time(SECOND);
minGapThisLeg = 9999;
dynamicAccel = 0;
legTravelStartTime = time();
dispatchTime = time();
targetLoadSiteId = main.selectNextLoadSite(this);
targetShovel = main.getLoadSiteById(targetLoadSiteId);

// 只有到达状态机实际采用点，pending 才升级为 active。
activeDecisionId = pendingDecisionId;
pendingDecisionId = "";

destinationNode = main.collectionLoadSites
    .get(targetLoadSiteId).getName();
intDestination = main.roadNodeNameToInt(destinationNode);

// 业务目标不得使用 destinationNode/targetNodeName 代替。
targetSiteBusinessId = targetShovel == null ? null : targetShovel.siteName;

// 展示遥测：当前运输区段只记录业务站点。
executionPhase = "TO_LOAD";
currentLegFromSiteId = currentBusinessSiteId;
currentLegToSiteId = targetSiteBusinessId;
nextSiteId = null;

traceln(destinationNode);
traceln(
    "[DECISION APPLY]"
    + " truck=" + vehicleId
    + " decision=" + activeDecisionId
    + " target=" + targetSiteBusinessId
);

if (targetShovel == null) {
    throw new IllegalStateException(
        "Unknown target load site: " + targetLoadSiteId
    );
}

if (incomingLoadSiteId != -1) {
    throw new IllegalStateException(
        "Truck already counted as incoming: truck=" + truckId
        + ", site=" + incomingLoadSiteId
    );
}

targetShovel.incomingTrucks++;
incomingLoadSiteId = targetLoadSiteId;
debugLastAction = "DispatchToLoad_" + targetLoadSiteId;
this.deliver("TOLOADSITE", this);]]></EntryAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760103701</Id>
					<Name><![CDATA[TravelToLoadSite]]></Name>
					<X>590</X><Y>530</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="190" Height="320">
						<ExitAction><![CDATA[/*
arrivalTime = time();
currentLoadSiteId = targetLoadSiteId;
currentLocationType = "LoadSite";
if(targetShovel != null && targetShovel.incomingTrucks > 0){
    targetShovel.incomingTrucks--;
}
*/
debugLastAction = "ArriveLoad_" + targetLoadSiteId;]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760117990</Id>
					<Name><![CDATA[QueueAtLoadSite]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>240</X><Y>910</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="23.754266211604097">
						<EntryAction><![CDATA[queueEnterTime = time(MINUTE);
if(! targetShovel.queue.contains(this)){
    targetShovel.queue.add(this);
}
debugLastAction = "QueueLoad_" +targetLoadSiteId;]]></EntryAction>
						<ExitAction><![CDATA[currentWaitTime = time(MINUTE) - queueEnterTime;
main.totalWaitTime += currentWaitTime;
loadStartTime = time();
debugLastAction = "StartLoad_" + targetLoadSiteId;]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760121526</Id>
					<Name><![CDATA[Loading]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>390</X><Y>990</Y>
					<Label><X>5</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="23.754266211604097">
						<ExitAction><![CDATA[loadFinishTime = time();
isLoaded = true;
payloadTons = capacity;

if( targetShovel != null){
    payloadIsOre = targetShovel.isOre;
    payloadGrade = targetShovel.grade;
    targetShovel.remainingTons -= payloadTons;
    targetShovel.producedTons += payloadTons;
    targetShovel.totalServiceTime += getServeTime(targetShovel.bucket, targetShovel.density, targetShovel.singleServeTime, capacity);
    targetShovel.busy = false;
}

// 规则决定去向
for(DumpSite d : main.dumpSites){
    if(payloadIsOre && d.acceptsOre){
        targetDumpSiteId = d.siteId;
        break;
    }
    if(!payloadIsOre && d.acceptsWaste){
        targetDumpSiteId = d.siteId;
        break;
    }
}

currentTravelTime = main.getTravelTimeToDumpSite(this, targetDumpSiteId);
debugLastAction = "FinishLoad_ToDump_" + targetDumpSiteId;]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760130326</Id>
					<Name><![CDATA[TravelToDumpSite]]></Name>
					<X>590</X><Y>1200</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="180" Height="280">
						<ExitAction><![CDATA[currentDumpSiteId = targetDumpSiteId;
]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760132742</Id>
					<Name><![CDATA[QueueAtDumpSite]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>980</X><Y>1530</Y>
					<Label><X>-10</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="190" Height="40">
						<EntryAction><![CDATA[queueEnterTime = time();
if( !targetDump.queue.contains(this)){
    targetDump.queue.add(this);
    }
debugLastAction = "QUEUE"+ targetDump.getName();]]></EntryAction>
						<ExitAction><![CDATA[currentWaitTime = time(MINUTE) - queueEnterTime;
main.totalWaitTime += currentWaitTime;
lastCycleWaitTime = main.totalWaitTime;
// 1. 抢占具体的信号灯位
this.mySpotIndex = targetDump.getFreeSpotIndex();
if (this.mySpotIndex != -1) {
    targetDump.dumpOccupied[this.mySpotIndex] = true;
}
// 2. 踢出排队数组
targetDump.queue.remove(this);
]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776760176270</Id>
					<Name><![CDATA[Dumping]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>600</X><Y>1630</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<ExitAction><![CDATA[if (this.mySpotIndex != -1) {
    targetDump.dumpOccupied[this.mySpotIndex] = false;
    this.mySpotIndex = -1;
}
DumpSite d = main.getDumpSiteById(currentDumpSiteId);
dumpFinishTime = time();

if(payloadIsOre && !main.isWarmUp){
    main.totalProduction += payloadTons;
    main.updateCrusherGrade(payloadTons, payloadGrade);
} else {
    main.totalWasteMoved += payloadTons;
}

if(d != null && ! main.isWarmUp){
    d.receivedTons += payloadTons;
    d.busy = false;
}

isLoaded = false;
payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;


debugLastAction = "FinishDump";]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
