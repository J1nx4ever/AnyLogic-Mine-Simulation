roadPointNodeMap.put("intersection2", intersection2);
roadPointNodeMap.put("intersection3", intersection3);
roadPointNodeMap.put("ShovelOreHigh2", ShovelOreHigh2);
roadPointNodeMap.put("ShovelOreHigh1", ShovelOreHigh1);
roadPointNodeMap.put("ShovelOreLow", ShovelOreLow);
roadPointNodeMap.put("ShovelWaste", ShovelWaste);
roadPointNodeMap.put("dumpNode", dumpNode);]]></Body>
